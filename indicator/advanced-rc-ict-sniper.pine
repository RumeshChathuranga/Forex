//@version=6
// max_bars_back is set explicitly because the zone engine walks back to the
// origin candle of an impulse leg using a series offset (close[off]), and Pine
// cannot infer the required history buffer for dynamic offsets on its own.
indicator("Advanced RC Indicator v3.4 - ICT Sniper", overlay=true, max_labels_count=500, max_boxes_count=500, max_lines_count=500, max_bars_back=500)



// ===== USER INPUTS =====
// Core FVG Settings
detectBISI = input.bool(true, "Detect Bullish FVGs (BISI)")
detectSIBI = input.bool(true, "Detect Bearish FVGs (SIBI)")

// ===== UNIVERSAL AUTO-CALIBRATION =====
// Every threshold is expressed as a multiple of ATR instead of hardcoded points,
// so identical defaults behave correctly on gold, FX pairs, indices and crypto.
calibSection = "Universal Calibration"
atrPeriod = input.int(14, "ATR Period (volatility unit)", minval=5, maxval=50, group=calibSection, tooltip="The reference volatility unit. All zone sizes, impulse thresholds and tolerances are measured in multiples of this ATR.")
minGapATR = input.float(0.10, "Min FVG Size (x ATR)", minval=0.01, maxval=2.0, step=0.01, group=calibSection, tooltip="Gaps smaller than this fraction of ATR are noise and get discarded.")
tapToleranceATR = input.float(0.15, "Zone Tap Tolerance (x ATR)", minval=0.0, maxval=1.0, step=0.05, group=calibSection, tooltip="How far outside a zone price may trade and still count as a valid tap.")
mitigationDepth = input.float(0.5, "FVG Mitigation Depth", minval=0.0, maxval=1.0, step=0.05, group=calibSection, tooltip="Fraction of the gap price must fill to mitigate it. 0.5 = Consequent Encroachment (ICT standard), 1.0 = full fill.")

// FVG Display Settings
fvgMaxAge = input.int(150, "Maximum FVG Age (bars)", minval=1)
maxTrackedFVGs = input.int(120, "Max Tracked FVGs (per side)", minval=20, maxval=300, tooltip="The working set the engine walks every bar. Every gap in it is re-examined on each bar and scanned again by the entry trigger, so this is the single biggest per-bar cost in the script. Raise it only if you trade a market that leaves more live gaps than this inside the maximum age.")
showMitigated = input.bool(false, "Show Mitigated FVGs")
extendFVG = input.bool(true, "Extend FVG Zones")

// Multi-Timeframe Analysis
mtfAnalysis = input.bool(true, "Multi-Timeframe Analysis")
higherTF = input.string("60", "Higher Timeframe", options=["60", "240", "D", "W"])

// Entry Signals
showEntrySignals = input.bool(true, "Show Entry Signals")
entryStrategy = input.string("Sharp Turn + Confirmation", "Entry Strategy", options=["Sharp Turn", "Sharp Turn + Confirmation"])
respectTrend = input.bool(true, "Only Show Trend-Aligned Signals", tooltip="When enabled, only shows buy signals in uptrends and sell signals in downtrends")
nonRepaintMode = input.bool(true, "Non-Repainting Mode", tooltip="Evaluate detection and signals only on confirmed bar closes. Signals never appear and then vanish, and alerts fire once per closed bar.")

// ===== ICT MARKET STRUCTURE SETTINGS =====
structureSection = "Market Structure (ICT)"
swingLen = input.int(20, "Swing Pivot Length", minval=3, maxval=50, group=structureSection, tooltip="Bars either side required to confirm a major swing pivot. Drives the primary trend and the dealing range.")
internalLen = input.int(5, "Internal Pivot Length", minval=2, maxval=20, group=structureSection, tooltip="Faster pivots used for internal structure shifts and entry timing.")
showMarketStructure = input.bool(true, "Show Swing Pivots (H/L)", group=structureSection)
showSwingStructure = input.bool(true, "Show Swing BOS / CHoCH / MSS", group=structureSection)
showInternalStructure = input.bool(false, "Show Internal BOS / CHoCH", group=structureSection)
dispATRMult = input.float(1.5, "Displacement Threshold (x ATR)", minval=0.3, maxval=5.0, step=0.1, group=structureSection, tooltip="Minimum candle body, in ATR multiples, for a move to count as displacement. A CHoCH backed by displacement is promoted to an MSS.")
dispWindow = input.int(3, "Displacement Lookback (bars)", minval=1, maxval=10, group=structureSection, tooltip="How recently displacement must have occurred for a structure break to qualify as an MSS.")
maxStructDrawings = input.int(30, "Max Structure Drawings", minval=5, maxval=120, group=structureSection, tooltip="Caps structure lines/labels so they never crowd out SL/TP lines against the 500-object limit.")

// ===== DEALING RANGE / PREMIUM-DISCOUNT =====
drSection = "Dealing Range (Premium / Discount)"
showDealingRange = input.bool(true, "Show Dealing Range", group=drSection)
showPDZones = input.bool(true, "Shade Premium / Discount Zones", group=drSection)

// Enhanced Risk Management Settings
riskSection = "Risk Management Settings"
riskManagement = input.bool(true, "Show Risk Management Levels", group=riskSection)
riskReward = input.float(2.0, "Risk:Reward Ratio", minval=0.5, step=0.5, tooltip="Target will be set at this multiple of the risk", group=riskSection)
slPaddingATR = input.float(0.25, "Stop Loss Padding (x ATR)", minval=0.0, maxval=2.0, step=0.05, tooltip="Buffer beyond the zone edge when Smart ATR SL/TP is off, in ATR multiples so it adapts to any instrument", group=riskSection)
trailingStop = input.bool(false, "Use Trailing Stop", group=riskSection)
trailTriggerPercent = input.float(50, "Trail Trigger (%)", minval=10, maxval=90, step=5, tooltip="% of TP reached to activate trailing stop", group=riskSection)
showPartialTP = input.bool(false, "Show Partial TP Levels", group=riskSection)
partialTPPercent = input.float(50, "Partial TP (%)", minval=10, maxval=90, step=5, tooltip="% of total TP distance for partial", group=riskSection)

// New Risk Management Features
breakevenStop = input.bool(true, "Use Breakeven Stop", group=riskSection)
breakevenTrigger = input.float(30, "Breakeven Trigger (%)", minval=10, maxval=90, step=5, tooltip="% of TP reached to move SL to breakeven", group=riskSection)
maxDailyLoss = input.float(5.0, "Max Daily Loss (%)", minval=0.5, maxval=20, step=0.5, tooltip="Maximum allowed loss per day as % of account", group=riskSection)
useVolatilityBasedSizing = input.bool(true, "Volatility-Based Position Sizing", group=riskSection)
timeBasedExit = input.bool(false, "Time-Based Exit", group=riskSection)
maxTradeHours = input.int(24, "Max Trade Duration (hours)", minval=1, maxval=168, tooltip="Maximum hours to hold a position", group=riskSection)

// New Risk Management Additions
maxConcurrentPositions = input.int(3, "Max Concurrent Positions", minval=1, maxval=10, group=riskSection)
maxTrackedTrades = input.int(12, "Max Tracked Trades (drawing budget)", minval=2, maxval=40, group=riskSection, tooltip="Each tracked trade owns five lines. This caps how many can exist at once so a burst of signals can never crowd the 500-line budget the zones and structure annotations share.")
riskPerTrade = input.float(1.0, "Risk Per Trade (%)", minval=0.1, maxval=5.0, group=riskSection)

// ===== CONFLUENCE SCORING SETTINGS =====
confluenceSection = "Confluence Scoring"
minConfluenceScore = input.float(40.0, "Minimum Confluence Score (0-100)", minval=0, maxval=100, step=5, group=confluenceSection, tooltip="Signals below this score are filtered out")
showScoreLabels = input.bool(true, "Show Score Labels on FVGs", group=confluenceSection)
scoreColorMode = input.bool(true, "Color-Code FVGs by Score", group=confluenceSection, tooltip="Override FVG colors with score-based gradient")

// Scoring Weights (sum to 100)
weightTrend = input.float(25.0, "Weight: Trend Alignment", minval=0, maxval=100, step=5, group=confluenceSection)
weightRSI = input.float(15.0, "Weight: RSI", minval=0, maxval=100, step=5, group=confluenceSection)
weightVolume = input.float(15.0, "Weight: Volume", minval=0, maxval=100, step=5, group=confluenceSection)
weightVariant = input.float(20.0, "Weight: FVG Variant", minval=0, maxval=100, step=5, group=confluenceSection)
weightSession = input.float(15.0, "Weight: Session Timing", minval=0, maxval=100, step=5, group=confluenceSection)
weightVolatility = input.float(10.0, "Weight: Volatility", minval=0, maxval=100, step=5, group=confluenceSection)

// ===== SESSIONS, KILLZONES & TIME =====
// Windows are session strings evaluated in a named timezone rather than fixed
// UTC hours.
sessionSection = "Sessions & Killzones"
showSessions = input.bool(true, "Show Trading Sessions", group=sessionSection)
showSessionBG = input.bool(true, "Session Background Highlight", group=sessionSection)
ictTZ = input.string("America/New_York", "Reference Timezone", options=["America/New_York", "Europe/London", "Asia/Tokyo", "UTC"], group=sessionSection, tooltip="Every killzone, macro and the True Day Open is defined against this clock. New York is the ICT standard and the only one the macro times were derived in.")
kzLondonStr = input.session("0200-0500", "London Killzone", group=sessionSection)
kzNYAMStr = input.session("0700-1000", "New York AM Killzone", group=sessionSection)
kzLNCloseStr = input.session("1000-1200", "London Close Killzone", group=sessionSection)
kzAsiaStr = input.session("2000-0000", "Asia Killzone", group=sessionSection)
showMacros = input.bool(true, "Highlight ICT Macros", group=sessionSection, tooltip="The 20-minute windows either side of the hour where the algorithm reprices toward liquidity. Far more precise than a three-hour killzone block, and only resolvable on charts of 15 minutes or less.")
showSilverBullet = input.bool(true, "Highlight Silver Bullet Windows", group=sessionSection, tooltip="10:00-11:00 New York is the flagship window; 03:00-04:00 London and 14:00-15:00 PM run the same model.")
showTDO = input.bool(true, "True Day Open (NY Midnight)", group=sessionSection, tooltip="00:00 New York — not the exchange session open. Price delivering above it is bullish for the day, below it bearish.")
showPO3 = input.bool(true, "Classify Power of 3 (AMD)", group=sessionSection, tooltip="Accumulation, Manipulation, Distribution — the day's three acts, anchored on the True Day Open.")
showJudas = input.bool(true, "Judas Swing", group=sessionSection, tooltip="The first sweep of the Asian range inside a killzone, reversed: the false move that positions traders the wrong way before the real expansion.")

// ===== LIQUIDITY POOLS & HTF LEVELS =====
poolSection = "Liquidity Pools & HTF Levels"
showEQ = input.bool(true, "Equal Highs / Lows (EQH / EQL)", group=poolSection, tooltip="Pivots inside the cluster tolerance are one pool of resting stops rather than several separate levels. The more pivots in the cluster, the more liquidity is parked there and the harder it pulls price.")
eqMinStrength = input.int(2, "Min Pivots per Pool", minval=2, maxval=8, group=poolSection)
poolMaxDrawn = input.int(8, "Max Pools Drawn", minval=2, maxval=20, group=poolSection)
showPDHL = input.bool(true, "PDH / PDL (Previous Day)", group=poolSection)
showPWHL = input.bool(true, "PWH / PWL (Previous Week)", group=poolSection)
showPMHL = input.bool(false, "PMH / PML (Previous Month)", group=poolSection)
showAsianRange = input.bool(true, "Asian Range Box", group=poolSection)
showTurtleSoup = input.bool(true, "Turtle Soup", group=poolSection, tooltip="A raid of the N-period extreme that closes back inside it and is then confirmed by CISD or a structure shift. Without that second leg it is only a long wick.")
tsLookback = input.int(20, "Turtle Soup Lookback (bars)", minval=5, maxval=200, group=poolSection)
tsConfirmBars = input.int(5, "Turtle Soup Confirm Window (bars)", minval=1, maxval=20, group=poolSection)

// ===== DRAW ON LIQUIDITY =====
dolSection = "Draw on Liquidity (DOL)"
showDOL = input.bool(true, "Show Draw on Liquidity", group=dolSection, tooltip="Ranks every unswept pool above and below price by how strongly it should attract delivery, and names the winner. That level is the objective a setup is measured to, instead of a fixed R multiple that has nothing to do with where the liquidity actually sits.")
dolMinDistATR = input.float(0.75, "Min Distance to Qualify (x ATR)", minval=0.0, maxval=10.0, step=0.25, group=dolSection, tooltip="A pool closer than this is already in reach and is not an objective worth taking a trade for.")
dolMaxDistATR = input.float(25.0, "Max Distance Considered (x ATR)", minval=2.0, maxval=200.0, step=1.0, group=dolSection)
dolBiasWeight = input.float(12.0, "Directional Bias Weight", minval=0.0, maxval=50.0, step=1.0, group=dolSection, tooltip="How far premium/discount position and the swing trend tilt the ranking toward one side. Zero ranks purely on magnetism.")

// ===== SNIPER SIGNAL ENGINE =====
// The engine that decides whether anything is worth taking. It runs in two
// stages: a top-down cascade of hard gates that all have to pass, and only then
// a weighted stack score on what survived.
sniperSection = "Sniper Engine (A+ Setups)"
enableSniper = input.bool(true, "Enable Sniper Engine", group=sniperSection, tooltip="The primary signal path. Fires rarely by design: every gate below must pass before a setup is even scored.")
aPlusThreshold = input.float(52.0, "A+ Score Threshold", minval=40.0, maxval=100.0, step=1.0, group=sniperSection, tooltip="Setups that clear every gate but score below this are drawn as watch markers instead of signals. Tune it from what you see: the number on each watch marker is that setup score, so if the best markers on your chart read 55 then 75 can never fire and 50 fires on the best few. A conflicted market genuinely tops out in the 50s.")
showWatchMarker = input.bool(true, "Show Watch Markers", group=sniperSection, tooltip="A small tag where every gate passed but the stack score fell short. Useful for seeing how close the engine came, and why.")
sniperCooldown = input.int(10, "Min Bars Between Signals", minval=0, maxval=200, group=sniperSection, tooltip="Stops one setup being re-signalled on every bar price spends inside the same array.")
maxStopATR = input.float(2.0, "Max Stop Distance (x ATR)", minval=0.5, maxval=10.0, step=0.25, group=sniperSection, tooltip="How far the stop may be widened past the array edge to reach the setup's swing invalidation — a purge wick or a Quasimodo head. Beyond this the array edge stands on its own, because a stop that far out is a different trade at a different size and its reward:risk will never qualify.")
minSignalRR = input.float(2.0, "Min Reward:Risk to Fire", minval=0.5, maxval=10.0, step=0.25, group=sniperSection, tooltip="Measured from the invalidation-based stop to the draw on liquidity. A setup that cannot pay this is not taken however well it scores.")
showLegacySignals = input.bool(false, "Also Show Legacy FVG Confluence Signals", group=sniperSection, tooltip="The simple FVG-tap signal with its confluence score. Off by default: it fires far more often, and on a much lower bar, than the sniper cascade.")

// ===== SNIPER HARD GATES =====
// Each gate can be switched off individually, and the dashboard checklist always
// shows which are armed and which are currently passing, so a quiet chart is
// explainable rather than mysterious.
// Only two are armed by default. Nine independent conditions that must all hold
// on the same bar multiply out to roughly one qualifying bar in several
// thousand, which is not "strict" — it is off. The ones disarmed here are not
// discarded: HTF bias, killzone, liquidity, SMT and DOL room are all scored by
// the weighted stack below, so they still decide whether a setup is good enough
// to fire, they just no longer each hold a veto. Arm more of them to tighten.
gateSection = "Sniper Hard Gates"
gateHTF = input.bool(false, "Require HTF Bias Alignment", group=gateSection)
htfBiasTF = input.string("240", "HTF Bias Timeframe", options=["60", "240", "D", "W"], group=gateSection)
htfBiasLen = input.int(20, "HTF Structure Length (bars)", minval=5, maxval=100, group=gateSection, tooltip="A close beyond the extreme of this many higher-timeframe bars is a break of structure up there. The bias latches until the opposite extreme is broken.")
gateITF = input.bool(false, "Require Intermediate PD Array Agreement", group=gateSection, tooltip="A live, unmitigated gap on the Multi-Timeframe higher timeframe pointing the same way as the trade.")
gatePD = input.bool(false, "Require Correct Half of Dealing Range", group=gateSection, tooltip="Never buy in premium, never sell in discount. Off by default because as a veto it deadlocks against the structure gate — in a downtrend price sits in discount, so shorts fail this and longs fail structure, and nothing can ever fire. It is scored by the stack instead.")
gateKZ = input.bool(false, "Require Active Killzone", group=gateSection)
gateStruct = input.bool(true, "Require Valid Structure State", group=gateSection, tooltip="Post-CISD, post-MSS/CHoCH, or a BOS continuation in the trade's direction. Armed by default: with no structure shift there is no reversal to trade.")
structValidWindow = input.int(15, "Structure Valid For (bars)", minval=1, maxval=100, group=gateSection)
gateLiq = input.bool(false, "Require Liquidity Taken", group=gateSection, tooltip="A purge, a Turtle Soup raid or a Judas swing in the trade's direction. Price has to have run stops before it reverses.")
liqTakenWindow = input.int(20, "Liquidity Taken Within (bars)", minval=1, maxval=100, group=gateSection)
gateSMT = input.bool(false, "Reject Opposing SMT Divergence", group=gateSection)
gateDOL = input.bool(false, "Require Draw on Liquidity in Trade Direction", group=gateSection)
dolMinRoomATR = input.float(2.0, "Min DOL Room (x ATR)", minval=0.5, maxval=20.0, step=0.5, group=gateSection)

// ===== SNIPER STACK WEIGHTS =====
// Stage B. Applied only to setups that already cleared every armed gate, so
// these decide *how good* a valid setup is, never whether it is valid.
stackSection = "Sniper Stack Weights"
wArray = input.float(20.0, "PD Array Quality", minval=0.0, maxval=50.0, step=1.0, group=stackSection, tooltip="Unicorn > BPR / Breaker > OB / IFVG > Mitigation / Rejection > bare gap.")
wFresh = input.float(8.0, "Zone Freshness", minval=0.0, maxval=50.0, step=1.0, group=stackSection)
wOTE = input.float(10.0, "OTE Overlap", minval=0.0, maxval=50.0, step=1.0, group=stackSection)
wDisp = input.float(10.0, "Displacement Strength", minval=0.0, maxval=50.0, step=1.0, group=stackSection)
wSeq = input.float(12.0, "CISD + MSS Agreement", minval=0.0, maxval=50.0, step=1.0, group=stackSection)
wVol = input.float(8.0, "Volume", minval=0.0, maxval=50.0, step=1.0, group=stackSection)
wSMT = input.float(10.0, "SMT Confirmation", minval=0.0, maxval=50.0, step=1.0, group=stackSection)
wTime = input.float(12.0, "Timing (Macro / Silver Bullet)", minval=0.0, maxval=50.0, step=1.0, group=stackSection)
wDOLRoom = input.float(10.0, "DOL Room & Alignment", minval=0.0, maxval=50.0, step=1.0, group=stackSection)
wPD = input.float(12.0, "Premium / Discount Half", minval=0.0, maxval=50.0, step=1.0, group=stackSection, tooltip="Buying discount and selling premium. Scored rather than vetoed: as a hard gate it deadlocked against the structure gate, because in a downtrend price sits in discount — so shorts were refused for being in the wrong half while longs were refused for having no bullish structure.")

// ===== SMT DIVERGENCE =====
smtSection = "SMT Divergence"
smtMode = input.string("Auto", "Correlated Instrument", options=["Auto", "Manual", "Off"], group=smtSection, tooltip="Auto picks the partner by asset class: gold against DXY (inverse), EURUSD against GBPUSD, NQ against SPX, BTC against ETH, and so on.")
smtSymbolInput = input.symbol("TVC:DXY", "Manual Symbol", group=smtSection)
smtCorrMode = input.string("Auto", "Correlation", options=["Auto", "Positive", "Inverse"], group=smtSection, tooltip="An inverse partner is normalised by negating its series, so a single set of comparisons covers both cases.")
smtLen = input.int(5, "SMT Pivot Length", minval=2, maxval=30, group=smtSection)
showSMT = input.bool(true, "Show SMT Labels", group=smtSection)

// ===== CISD — CHANGE IN STATE OF DELIVERY =====
// The earliest reversal trigger in the engine. Where CHoCH waits for a swing
// point to break, CISD fires the moment a body closes through the opening price
// of the consecutive opposing-direction candle run that delivered price into the
// extreme — typically 2-4 candles earlier, for a much tighter stop.
cisdSection = "CISD (Change in State of Delivery)"
showCISD = input.bool(true, "Show CISD Triggers", group=cisdSection)
cisdMinRun = input.int(2, "Min Delivery Run Length (candles)", minval=1, maxval=10, group=cisdSection, tooltip="How many consecutive same-direction closes must have delivered price into the extreme before its opening level counts as a CISD reference. 1 fires on every single-candle flip; 2-3 keeps only real delivery legs.")
cisdExtremeLookback = input.int(12, "Run Must Own Extreme Of (bars)", minval=3, maxval=60, group=cisdSection, tooltip="The delivery run has to have produced the lowest low / highest high of this window. Without it, CISD fires on every pullback inside a trend instead of only at turning points.")
cisdRequirePurge = input.bool(false, "Require Liquidity Purge First", group=cisdSection, tooltip="Only fire CISD when a tracked level was purged into the extreme. Far stricter and closer to the ICT 2022 Model sequence.")
cisdMaxAge = input.int(40, "CISD Max Age (bars)", minval=5, maxval=200, group=cisdSection)

// ===== LIQUIDITY PURGE (SWEEP) SETTINGS =====
// A purge is price trading beyond a tracked level and closing back inside it.
liqSection = "Liquidity Purge (Sweeps)"
showLiqSweeps = input.bool(true, "Show Liquidity Purges", group=liqSection)
sweepConfirmBars = input.int(3, "Purge Confirm Window (bars)", minval=1, maxval=10, group=liqSection, tooltip="Price must close back inside the level within this many bars. If it does not, the level was genuinely broken rather than swept.")
sweepMinPierceATR = input.float(0.02, "Min Pierce Depth (x ATR)", minval=0.0, maxval=1.0, step=0.01, group=liqSection, tooltip="How far beyond the level price must trade before the breach counts, so a one-tick graze is ignored.")
sweepTrackInternal = input.bool(true, "Track Internal Pivots as Liquidity", group=liqSection, tooltip="Adds the faster internal pivots to the level registry alongside the major swings.")
sweepClusterATR = input.float(0.15, "Level Cluster Tolerance (x ATR)", minval=0.0, maxval=1.0, step=0.05, group=liqSection, tooltip="Pivots within this distance are merged into one level, so a single equal-highs cluster produces one purge instead of several.")
sweepMaxAge = input.int(60, "Purge Max Age (bars)", minval=10, maxval=300, group=liqSection)
levelMaxAge = input.int(400, "Untouched Level Max Age (bars)", minval=50, maxval=1000, group=liqSection)

// ===== ZONE MODEL — OB / BREAKER / MITIGATION =====
// Every zone carries body-based boundaries, a 50% mean threshold, a touch count
// and a flip state, so freshness and quality are properties of everything on the
// chart.
zoneSection = "Zones (OB / Breaker / Mitigation)"
showZones = input.bool(true, "Show Zones", group=zoneSection)
zoneUseWicks = input.bool(false, "Use Wick Boundaries", group=zoneSection, tooltip="Off = body-based zone (open to close of the origin candle), which is the boundary that actually holds. On = the full candle range.")
zoneShowMean = input.bool(true, "Show Mean Threshold (50%)", group=zoneSection, tooltip="The consequent encroachment line. ICT entries are taken at the mean, not the far edge.")
zoneOnInternalBreaks = input.bool(true, "Also Build Zones on Internal Breaks", group=zoneSection, tooltip="Off = only major swing BOS/CHoCH/MSS legs produce zones (very few, very high quality).")
zoneOriginLookback = input.int(12, "Origin Candle Search (bars)", minval=3, maxval=50, group=zoneSection, tooltip="How far back from the impulse leg's start to look for the last opposite-colour candle.")
zoneMinImpulseATR = input.float(0.6, "Min Impulse Leg Size (x ATR)", minval=0.1, maxval=5.0, step=0.1, group=zoneSection, tooltip="The leg away from the origin candle must span at least this much ATR, which is what separates a real order block from any two-candle pair.")
zoneLiqWindow = input.int(10, "Liquidity Check Window (bars)", minval=3, maxval=50, group=zoneSection, tooltip="A leg that took out the extreme of this window grabbed liquidity and is tagged OB. A leg that reversed without taking it is a Mitigation block.")
zoneMaxTouches = input.int(3, "Retire Zone After N Touches", minval=1, maxval=10, group=zoneSection, tooltip="Fresh (0 touches) is the highest quality. A zone tapped this many times is spent.")
zoneMaxAge = input.int(200, "Zone Max Age (bars)", minval=10, maxval=1000, group=zoneSection)
showBreakers = input.bool(true, "Show Breaker Blocks", group=zoneSection, tooltip="A violated order block that structure then confirmed against — failed supply becomes demand and vice versa.")
showMitigationBlocks = input.bool(true, "Show Mitigation Blocks", group=zoneSection)
breakerWindow = input.int(10, "Breaker Structure Window (bars)", minval=1, maxval=50, group=zoneSection, tooltip="A violated zone only becomes a Breaker if structure broke in the same direction this recently. Otherwise it is simply spent.")
maxZones = input.int(18, "Max Zones Drawn", minval=4, maxval=60, group=zoneSection)

// ===== QUASIMODO =====
// Emitted as a named pattern off the pivot + purge + structure engines rather
// than as a standalone module: Left Shoulder -> Leg -> Head sweeping the
// shoulder -> break through the Leg -> retrace to the shoulder (the QML entry).
qmSection = "Quasimodo (QM)"
showQM = input.bool(true, "Show Quasimodo Patterns", group=qmSection)
qmMinSweepATR = input.float(0.10, "Min Head Sweep Depth (x ATR)", minval=0.0, maxval=2.0, step=0.05, group=qmSection, tooltip="How far the Head must run beyond the Left Shoulder for the sweep to be meaningful.")
qmMaxAge = input.int(80, "QM Max Age (bars)", minval=10, maxval=400, group=qmSection)

// ===== PD ARRAY ARSENAL =====
// Nothing here builds a parallel zone map, so freshness, touch counting, the 50%
// mean threshold and the whole lifecycle come for free.
pdSection = "PD Arrays (IFVG / BPR / Unicorn / Blocks)"
showIFVG = input.bool(true, "Inversion FVGs (IFVG)", group=pdSection, tooltip="A gap that price closed clean through has not been filled, it has failed. It flips polarity and is re-published as a zone facing the other way — failed support becomes resistance.")
ifvgPierceATR = input.float(0.05, "IFVG Close-Through Depth (x ATR)", minval=0.0, maxval=1.0, step=0.01, group=pdSection, tooltip="How far beyond the far edge the body must close before the gap counts as inverted rather than merely filled.")
showBPR = input.bool(true, "Balanced Price Ranges (BPR)", group=pdSection, tooltip="A bullish and a bearish FVG that overlap. The overlap itself is the array: price delivered inefficiently in both directions through the same band.")
bprWindow = input.int(30, "BPR Pairing Window (bars)", minval=3, maxval=200, group=pdSection, tooltip="How far apart the two gaps may be created and still pair into one balanced range.")
bprMinOverlapATR = input.float(0.04, "Min BPR Overlap (x ATR)", minval=0.0, maxval=1.0, step=0.01, group=pdSection)
showUnicorn = input.bool(true, "Unicorn Model (Breaker + FVG)", group=pdSection, tooltip="A breaker block overlapping a same-direction FVG. Structure failed and the reversal was delivered with displacement through the same band — the highest tier array in the engine.")
unicornWindow = input.int(30, "Unicorn Pairing Window (bars)", minval=3, maxval=200, group=pdSection)
showPropulsion = input.bool(true, "Propulsion Blocks", group=pdSection, tooltip="An order block that forms inside a live block of the same direction: the algorithm returning to its own level to continue delivery rather than to reverse.")
showRejectionBlocks = input.bool(true, "Rejection Blocks", group=pdSection, tooltip="The wick of a pivot candle that speared liquidity and was thrown back. The block is the wick alone, body extreme to wick extreme.")
rbWickRatio = input.float(0.55, "Rejection Wick / Range Ratio", minval=0.3, maxval=0.95, step=0.05, group=pdSection)
rbMinWickATR = input.float(0.35, "Min Rejection Wick (x ATR)", minval=0.05, maxval=3.0, step=0.05, group=pdSection)
showVI = input.bool(false, "Volume Imbalances", group=pdSection, tooltip="A gap between two candle bodies whose ranges still overlap — an imbalance too small to be an FVG. Off by default: they are numerous and price revisits them constantly.")
viMinATR = input.float(0.10, "Min Volume Imbalance (x ATR)", minval=0.01, maxval=1.0, step=0.01, group=pdSection)
showOG = input.bool(true, "Opening Gaps (NDOG / NWOG)", group=pdSection, tooltip="New Day and New Week Opening Gaps — the gap between the prior session close and the new session open. Reference levels: they are never retired for being traded through.")
ogMinATR = input.float(0.02, "Min Opening Gap (x ATR)", minval=0.0, maxval=1.0, step=0.01, group=pdSection)
showFVGCE = input.bool(true, "Show FVG Consequent Encroachment", group=pdSection, tooltip="The 50% line of every live gap. This is where ICT entries are actually taken, not the far edge.")
requireCETap = input.bool(true, "Require CE Tap for Entry", group=pdSection, tooltip="An entry only triggers once price reaches the gap's 50% line. Fewer signals, deeper and better-priced fills. Pair it with an FVG Mitigation Depth of 0.5 or deeper: a shallower depth retires the gap before price ever reaches its CE.")

// ===== OTE & STANDARD DEVIATION PROJECTIONS =====
oteSection = "OTE & Standard Deviation Projections"
showOTE = input.bool(true, "Show OTE Band (0.62 / 0.705 / 0.79)", group=oteSection, tooltip="The Optimal Trade Entry retracement of the current impulse leg.")
showSDProj = input.bool(true, "Show Standard Deviation Projections", group=oteSection, tooltip="Objectives projected past the leg extreme at 0.5 / 1 / 2 standard deviations of the leg itself.")
useSDTargets = input.bool(true, "Use SD Projections as TP2 / TP3", group=oteSection, tooltip="Replaces the arbitrary 0.75R / 1.5R partials with the leg's own measured objectives, falling back to R-multiples when the current leg points against the trade.")
oteMinLegATR = input.float(1.0, "Min Leg Size (x ATR)", minval=0.2, maxval=10.0, step=0.1, group=oteSection, tooltip="Legs smaller than this are noise and produce no OTE band or projections.")

// ===== SMART ATR SL/TP SETTINGS =====
atrSection = "Smart ATR SL/TP"
useSmartATR = input.bool(true, "Use Smart ATR SL/TP", group=atrSection, tooltip="ATR-based stops that adapt to the instrument's own volatility — overrides fixed SL padding")
atrSLMultiplier = input.float(1.5, "ATR SL Multiplier", minval=0.5, maxval=5.0, step=0.1, group=atrSection)
atrTPMultiplier = input.float(3.0, "ATR TP Multiplier", minval=1.0, maxval=10.0, step=0.5, group=atrSection)

// Display Settings
displaySection = "Display Settings"
showStatusTable = input.bool(true, "Show Status Table", group=displaySection)
redrawEveryTick = input.bool(false, "Redraw Every Tick", group=displaySection, tooltip="Off (default): drawings and both panels are rebuilt once per bar. Every detector here is already gated to confirmed bars, so rebuilding on each tick deletes and recreates several hundred boxes, lines and labels to produce an identical picture — it is the dominant cost in real time. On: legacy behaviour, worth having only when Non-Repainting Mode is off and you want intrabar zones to move live.")


