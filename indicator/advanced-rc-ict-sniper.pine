// ===== DATA STRUCTURES =====
type RiskLevels
    int entryBarIdx
    float entryPrice
    float slPrice
    float tpPrice
    float partialTP
    float partialTP2
    float partialTP3
    string signalType
    int lastBarDrawn
    bool active
    line slLine
    line tpLine
    line partialLine
    line partialLine2
    line partialLine3

// FVG Structure start_time / candle3_time are the real chart timestamps of the
// first and third candle of the gap. Boxes are drawn with xloc.bar_time so HTF
// zones land on the bars they actually belong to instead of being offset from
// the chart's bar_index.
type FVG
    int start_idx
    int candle3_idx
    int start_time
    int candle3_time
    float top
    float bottom
    string fvgType
    string fvgVariant
    bool mitigated
    int mitigatedBar     // the bar the gap was first penetrated to mitigationDepth
    string timeframe
    int creation_bar_idx

type SwingPoint
    int index
    float price
    bool isHigh

// ── Shared Zone model ──────────────────────────────────────────────
// One object for every price-delivery array in the system. Boundaries are body-
// based by default (the MSNR insight) with the wick range carried alongside, and
// `mean` is the 50% mean threshold — the same level as consequent encroachment —
// which is where entries are actually taken.
type Zone
    float top
    float bottom
    float mean
    float wickTop
    float wickBottom
    string kind          // OB | Propulsion | Breaker | Mitigation | IFVG | BPR | Unicorn | Rejection | VI | NDOG | NWOG
    int dir              // +1 = demand (bullish), -1 = supply (bearish)
    int touches          // 0 = fresh = highest quality
    bool flipped         // has been violated and re-purposed in the opposite direction
    bool mitigated
    bool active
    int createdBar       // the origin candle, used as the box's left edge
    int confirmBar       // the bar the structure break validated it on
    int lastTouchBar
    string origin        // the structure event that validated it: MSS / CHoCH / BOS / i-BOS

// ── Liquidity level registry ─────────────────────────────────────────────────
// Every confirmed pivot becomes a resting level. Levels are either purged (price
// trades beyond, then closes back inside) or genuinely broken.
type LiqLevel
    float price
    int barIdx
    int firstBar        // the pivot that opened the cluster — the pool's left edge
    bool isHigh
    bool major           // major swing pivot vs faster internal pivot
    int strength         // how many pivots merged into this level
    bool swept
    bool broken
    int pierceBar        // na until price first trades beyond the level
    float wickExtreme    // furthest point reached beyond it — the stop reference

// A confirmed purge. `wickExtreme` is the invalidation point every reversal
// model in the engine measures its stop from.
type LiquiditySweep
    int pierceBar
    int confirmBar
    float sweptLevel
    float wickExtreme
    int dir              // +1 = sellside purge (lows taken, expect up), -1 = buyside purge
    bool major
    bool invalidated

// ── Change in State of Delivery ──────────────────────────────────────────────
// The run being tracked lives in scalar globals rather than an object, because
// Pine functions may mutate a global collection but may not reassign a global
// variable — and the run has to advance in the global scope for the same reason
// the structure engine does. Only completed CISD events are stored as objects.
type CISDEvent
    int barIdx
    int runStart
    float level          // the delivery run's opening price that was closed through
    float extreme        // the run's low (bullish CISD) or high (bearish)
    int dir              // +1 bullish, -1 bearish
    bool displaced       // the breaking close itself carried displacement
    bool purged          // liquidity was taken into the extreme first

// ── Quasimodo ────────────────────────────────────────────────────────────────
// qml is the Left Shoulder price — the entry. The stop sits beyond the Head and
// the first objective is the broken Leg.
type QMPattern
    int barIdx
    int dir              // +1 bullish, -1 bearish
    float qml
    float head
    float leg
    int lsBar
    int headBar
    int legBar
    bool active

// ── An armed entry ───────────────────────────────────────────────────────────
// Price reaching a live array and price confirming it has turned there are two
// separate events, usually several candles apart. This object is what remembers
// the first one while the engine waits for the second.
//
// `armExtreme` is the furthest price has reached into the array since arming —
// the wick that actually tested the level. That is the setup's true invalidation
// and the stop is measured from it, which is both tighter and more honest than
// the array's own edge.
type ArmedSetup
    int dir              // +1 long, -1 short
    float top
    float bottom
    float mean           // the 50% mean threshold = consequent encroachment
    int tier             // array quality, captured at arm time
    string kind
    bool fresh
    int armBar
    float armExtreme


// ===== GLOBAL VARIABLES =====
var RiskLevels[] riskLevels = array.new<RiskLevels>()
var FVG[] bullishFVGs = array.new<FVG>()
var FVG[] bearishFVGs = array.new<FVG>()
var SwingPoint[] swingPoints = array.new<SwingPoint>()

var string marketStructure = "Neutral"

// ===== ENGINE STATE =====
// One zone map for OBs, Breakers and Mitigation blocks
var Zone[] zones = array.new<Zone>()

// Liquidity level registry and the purges confirmed against it
var LiqLevel[] liqLevels = array.new<LiqLevel>()
var LiquiditySweep[] liqSweeps = array.new<LiquiditySweep>()

// CISD events, and Quasimodo patterns
var CISDEvent[] cisdEvents = array.new<CISDEvent>()
var QMPattern[] qmPatterns = array.new<QMPattern>()

// ── Delivery run tracking (drives both CISD and the zone origin candle) ──
// Held as scalar globals rather than inside a function because Pine functions
// may mutate a global collection but may not reassign a global variable.
var int runDir = 0
var int dnRunStart = na
var float dnRunOpen = na
var float dnRunLow = na
var int dnRunLen = 0
var bool dnRunBroken = true
var int upRunStart = na
var float upRunOpen = na
var float upRunHigh = na
var int upRunLen = 0
var bool upRunBroken = true

// ── Armed entries, and the confirmations they produced this bar ──────────────
// Setups waiting for their confirmation candle. Confirmations are moved into the
// two single-element buffers below rather than returned, because a function may
// mutate a global collection but may not reassign a global variable — the same
// device the delivery run and the flip flag already use.
var ArmedSetup[] armedSetups = array.new<ArmedSetup>()
var ArmedSetup[] confirmedLong = array.new<ArmedSetup>()
var ArmedSetup[] confirmedShort = array.new<ArmedSetup>()

// ── Per-bar caches (performance) ─────────────────────────────────────────────
// Everything downstream reduces to an integer comparison against these.
var int livePurgeUpBar = na
var float livePurgeUpWick = na
var int livePurgeDnBar = na
var float livePurgeDnWick = na
// Whether a live higher-timeframe gap exists on each side. The sniper cascade
// asked this once per direction, and each ask walked the whole gap array.
var bool itfGapBull = false
var bool itfGapBear = false

// Latest event summaries, surfaced on the dashboard and reused by later phases
var string lastCISDDir = "None"
var int lastCISDBar = na
var float lastCISDLevel = na
var string lastPurgeDir = "None"
var int lastPurgeBar = na
var float lastPurgeExtreme = na
var string lastQMDir = "None"
var int lastQMBar = na

// Drawing object references (so we can delete-and-redraw instead of piling up
// new boxes/labels/lines every time the draw functions run)
var box[] fvgBoxRefs = array.new<box>()
var label[] fvgLabelRefs = array.new<label>()
var label[] sweepLabelRefs = array.new<label>()
var line[] sweepLineRefs = array.new<line>()

// Zone / CISD / QM drawing references
var box[] zoneBoxRefs = array.new<box>()
var label[] zoneLabelRefs = array.new<label>()
var line[] zoneLineRefs = array.new<line>()
var line[] cisdLineRefs = array.new<line>()
var label[] cisdLabelRefs = array.new<label>()
var line[] qmLineRefs = array.new<line>()
var label[] qmLabelRefs = array.new<label>()

// FVG-CE and OTE drawing references
var line[] fvgCELineRefs = array.new<line>()
var box[] oteBoxRefs = array.new<box>()
var line[] oteLineRefs = array.new<line>()
var label[] oteLabelRefs = array.new<label>()

// A zone flipping to Breaker has to be visible to the Unicorn pairing pass, but
// updateZones() cannot reassign a global scalar, so the bar index of the most
// recent flip is parked in a one-element array — the same device the delivery
// run and the signal trigger references use.
var int[] flipFlag = array.new_int(1, -1)

// Structure + dealing range drawing references
var line[] structLineRefs = array.new<line>()
var label[] structLabelRefs = array.new<label>()
var label[] pivotLabelRefs = array.new<label>()
var box[] drBoxRefs = array.new<box>()
var line[] drLineRefs = array.new<line>()
var label[] drLabelRefs = array.new<label>()

// ===== UNIVERSAL VOLATILITY UNIT =====
// Single reference used by every threshold in the script. Hoisted to the global
// scope so no ta.* call ever executes inside a conditional branch or a loop,
// which would otherwise corrupt its history series.
atrRef = ta.atr(atrPeriod)
atrRefSMA = ta.sma(atrRef, 50)
volUnit = math.max(nz(atrRef), syminfo.mintick * 10)
tapTol = tapToleranceATR * volUnit

// ===== NON-REPAINT GATE =====
// barstate.isconfirmed is always true on historical bars, so historical output
// is unchanged; only the live forming bar is held back until it closes.
barConfirmed = barstate.isconfirmed
canDetect = not nonRepaintMode or barConfirmed

// Is the Multi-Timeframe setting actually above the chart? When there is no
// genuine intermediate term, that gate has nothing to check and stands down.
htfIsHigher = timeframe.in_seconds(higherTF) > timeframe.in_seconds()

// ===== REDRAW GATE =====
// Since every detector in this script is gated on confirmed bars, all of that
// work produced a picture identical to the one already on screen. This gate lets
// the rebuild happen once per bar instead.
var int lastUIBar = -1
uiRedraw = barstate.islast and (redrawEveryTick or not nonRepaintMode or barConfirmed or lastUIBar != bar_index)
if uiRedraw
    lastUIBar := bar_index

// ═══════════════════════════════════════════════════════════════════════════
// TIME ENGINE — KILLZONES, MACROS, SILVER BULLET, TRUE DAY OPEN, ASIAN RANGE
// ═══════════════════════════════════════════════════════════════════════════
// Placed ahead of everything else because time is not a filter bolted on at the
// end — the window a setup forms in is part of what the setup *is*, and session
// timing is one of the confluence factors scored further down this file.
// time(timeframe.period, session, timezone) returns na outside its window, so a
// na-test is the membership test.
inLondonKZ = not na(time(timeframe.period, kzLondonStr, ictTZ))
inNYAMKZ = not na(time(timeframe.period, kzNYAMStr, ictTZ))
inLNCloseKZ = not na(time(timeframe.period, kzLNCloseStr, ictTZ))
inAsiaKZ = not na(time(timeframe.period, kzAsiaStr, ictTZ))
inAnyKZ = inLondonKZ or inNYAMKZ or inLNCloseKZ or inAsiaKZ

// ── ICT macros ──
// The 20-minute windows either side of the hour in which the algorithm reprices
// to liquidity. Named individually because *which* macro is live matters: the
// 09:50 and 10:50 windows carry the New York AM expansion, the 02:33 and 04:03
// windows belong to London, and the afternoon pair runs into the futures close.
macroTFOK = timeframe.isintraday and timeframe.in_seconds() <= 900
mLon1 = macroTFOK and not na(time(timeframe.period, "0233-0300", ictTZ))
mLon2 = macroTFOK and not na(time(timeframe.period, "0403-0430", ictTZ))
mNY1 = macroTFOK and not na(time(timeframe.period, "0850-0910", ictTZ))
mNY2 = macroTFOK and not na(time(timeframe.period, "0950-1010", ictTZ))
mNY3 = macroTFOK and not na(time(timeframe.period, "1050-1110", ictTZ))
mNY4 = macroTFOK and not na(time(timeframe.period, "1150-1210", ictTZ))
mPM1 = macroTFOK and not na(time(timeframe.period, "1310-1340", ictTZ))
mPM2 = macroTFOK and not na(time(timeframe.period, "1515-1545", ictTZ))
inMacro = mLon1 or mLon2 or mNY1 or mNY2 or mNY3 or mNY4 or mPM1 or mPM2
macroName = mLon1 ? "02:33 LDN" : mLon2 ? "04:03 LDN" : mNY1 ? "08:50 NY" : mNY2 ? "09:50 NY" : mNY3 ? "10:50 NY" : mNY4 ? "11:50 NY" : mPM1 ? "13:10 PM" : mPM2 ? "15:15 PM" : ""

// ── Silver Bullet ──
// One hour, one model: take the FVG left by the displacement inside the window
// and target the liquidity it was delivered away from. The 10:00-11:00 New York
// window is the flagship; the other two run identically.
sbLondon = not na(time(timeframe.period, "0300-0400", ictTZ))
sbAM = not na(time(timeframe.period, "1000-1100", ictTZ))
sbPM = not na(time(timeframe.period, "1400-1500", ictTZ))
inSilverBullet = sbLondon or sbAM or sbPM
sbName = sbAM ? "AM 10-11" : sbLondon ? "LDN 03-04" : sbPM ? "PM 14-15" : ""

// ── True Day Open ──
// Midnight New York, which is where the daily dealing range is actually opened,
// rather than the exchange session open the chart happens to use. Derived from
// the New York calendar date so the DST shift is handled by the same clock as
// everything else above.
nyDateIdx = dayofmonth(time, ictTZ)
newNYDay = na(nyDateIdx[1]) or nyDateIdx != nyDateIdx[1]
var float trueDayOpen = na
var int tdoBar = na
if newNYDay
    trueDayOpen := open
    tdoBar := bar_index
tdoBiasUp = not na(trueDayOpen) and close > trueDayOpen

// ── Asian range ──
// Built live through the Asia killzone and then held: London and New York trade
// *against* the range Asia left behind, so the values have to persist once the
// session closes instead of resetting with it. Accumulation is monotonic — only
// math.max / math.min — so the forming bar can extend the range but can never
// retract it, and no non-repaint gate is needed here.
var float asiaHigh = na
var float asiaLow = na
var int asiaStartBar = na
var int asiaEndBar = na
if inAsiaKZ
    if not inAsiaKZ[1]
        asiaHigh := high
        asiaLow := low
        asiaStartBar := bar_index
    else
        asiaHigh := math.max(nz(asiaHigh, high), high)
        asiaLow := math.min(nz(asiaLow, low), low)
    asiaEndBar := bar_index

// ═══════════════════════════════════════════════════════════════════════════
// DATA REQUESTS — HTF LEVELS AND THE CORRELATED INSTRUMENT
// ═══════════════════════════════════════════════════════════════════════════
// Four request.security() calls total, well inside the 40-call limit, and all of
// them hoisted to the global scope so no stateful call ever lives in a branch.
// The previous-period extremes use lookahead_on *together with* a [1] offset on
// the expression.
[pdhRaw, pdlRaw] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pwhRaw, pwlRaw] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pmhRaw, pmlRaw] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead=barmerge.lookahead_on)

// How long the current period has been running, used as the "age" term when the
// previous period's extreme is ranked as a draw on liquidity.
barsSinceDay = ta.barssince(timeframe.change("D"))
barsSinceWeek = ta.barssince(timeframe.change("W"))
barsSinceMonth = ta.barssince(timeframe.change("M"))

// ── Correlated instrument selection ──
// syminfo.ticker is a simple string, so the whole chain below resolves at
// compile time and request.security() accepts it. Only the metals pairing is
// inverse; everything else moves with its partner.
smtTk = str.upper(syminfo.ticker)
smtIsXAU = str.contains(smtTk, "XAU") or str.contains(smtTk, "GOLD")
smtIsXAG = str.contains(smtTk, "XAG") or str.contains(smtTk, "SILVER")
smtIsEUR = str.contains(smtTk, "EURUSD")
smtIsGBP = str.contains(smtTk, "GBPUSD")
smtIsJPY = str.contains(smtTk, "USDJPY")
smtIsAUD = str.contains(smtTk, "AUDUSD")
smtIsNZD = str.contains(smtTk, "NZDUSD")
smtIsCAD = str.contains(smtTk, "USDCAD")
smtIsCHF = str.contains(smtTk, "USDCHF")
smtIsNQ = str.contains(smtTk, "NQ") or str.contains(smtTk, "NAS") or str.contains(smtTk, "US100") or str.contains(smtTk, "NDX")
smtIsES = str.contains(smtTk, "ES1") or str.contains(smtTk, "SPX") or str.contains(smtTk, "SPY") or str.contains(smtTk, "US500")
smtIsYM = str.contains(smtTk, "YM1") or str.contains(smtTk, "DJI") or str.contains(smtTk, "US30")
smtIsBTC = str.contains(smtTk, "BTC") or str.contains(smtTk, "XBT")
smtIsETH = str.contains(smtTk, "ETH")
autoSmtSym = smtIsXAU ? "TVC:DXY" : smtIsXAG ? "TVC:GOLD" : smtIsEUR ? "GBPUSD" : smtIsGBP ? "EURUSD" : smtIsJPY ? "USDCHF" : smtIsAUD ? "NZDUSD" : smtIsNZD ? "AUDUSD" : smtIsCAD ? "USDCHF" : smtIsCHF ? "USDJPY" : smtIsNQ ? "SPX" : smtIsES ? "NDX" : smtIsYM ? "SPX" : smtIsBTC ? "ETHUSD" : smtIsETH ? "BTCUSD" : syminfo.tickerid
autoSmtInverse = smtIsXAU
smtSymUsed = smtMode == "Manual" ? smtSymbolInput : autoSmtSym
// ignore_invalid_symbol keeps an unavailable partner from erroring the whole
// script out; it returns na and SMT reports itself unavailable instead.
[smtHRaw, smtLRaw] = request.security(smtSymUsed, timeframe.period, [high, low], lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
smtInverse = smtCorrMode == "Inverse" or (smtCorrMode == "Auto" and smtMode != "Manual" and autoSmtInverse)
// Negating an inverse partner normalises it, so one set of higher-high / lower-
// low comparisons covers both correlation types.
smtHAdj = smtInverse ? -smtLRaw : smtHRaw
smtLAdj = smtInverse ? -smtHRaw : smtLRaw
smtAvailable = smtMode != "Off" and smtSymUsed != syminfo.tickerid and not na(smtHRaw)

// ── Higher timeframe bias ──
// The top of the cascade. The structure engine itself is stateful global code
// and cannot be evaluated inside a request, so the bias is derived the way a
// break of structure is defined in the first place: a higher-timeframe close
// beyond the extreme of the preceding htfBiasLen bars up there.
[htfBiasClose, htfBiasHi, htfBiasLo] = request.security(syminfo.tickerid, htfBiasTF, [close, ta.highest(high, htfBiasLen)[1], ta.lowest(low, htfBiasLen)[1]], lookahead=barmerge.lookahead_off)
var int htfBias = 0
if not na(htfBiasClose)
    if not na(htfBiasHi) and htfBiasClose > htfBiasHi
        htfBias := 1
    else if not na(htfBiasLo) and htfBiasClose < htfBiasLo
        htfBias := -1

// ===== ICT STRUCTURE ENGINE STATE =====
// Swing structure drives the primary trend and the dealing range.
var float swingHighPrice = na
var int swingHighBar = na
var float swingLowPrice = na
var int swingLowBar = na
var bool swingHighTaken = false
var bool swingLowTaken = false
var int swingTrend = 0

// Internal structure gives faster shifts used for entry timing.
var float intHighPrice = na
var int intHighBar = na
var float intLowPrice = na
var int intLowBar = na
var bool intHighTaken = false
var bool intLowTaken = false
var int intTrend = 0

// Displacement tracking
var int lastDispUpBar = -1
var int lastDispDnBar = -1

// Most recent structure event, surfaced on the dashboard
var string lastStructEvent = "None"
var int lastStructBar = na
var string lastStructDir = ""

// Most recent structure event of *any* resolution, including internal breaks.
// The Breaker transition reads this rather than the major-swing event: with a
// 20-bar swing length, major breaks are far too infrequent to confirm a zone
// flip while the violated zone is still relevant.
var int lastAnyStructBar = na
var string lastAnyStructDir = ""

// Dealing range / premium-discount
var float drHigh = na
var float drLow = na
var float drEq = na
var bool inPremium = false
var bool inDiscount = false

// ── OTE leg and its standard deviation projections ─────────────────
// Declared here rather than where they are computed, because the sniper engine
// reads them for its objectives and Pine resolves identifiers in file order. The
// values are assigned in the engine section, after the dealing range that
// defines the leg and before any signal consumes them.
var int oteDir = 0
var bool oteValid = false
var float oteAnchor = na    // the leg's origin
var float oteExtreme = na   // the leg's extreme, which keeps extending with price
var float ote62 = na
var float ote705 = na
var float ote79 = na
var float sd05 = na
var float sd10 = na
var float sd20 = na

// ── Pools, Draw on Liquidity, named time patterns, SMT ──────────────────────
// Declared here with the rest of the engine state rather than beside the logic
// that fills them, because updateStatusTable() is defined long before the Phase
// 4 engine section runs and Pine resolves identifiers in file order — a var
// introduced next to its own logic would be invisible to the dashboard.
var float dolPx = na
var int dolDir = 0
var string dolName = "None"
var float dolScore = 0.0
var float dolAbovePx = na
var float dolBelowPx = na
var float dolAboveScore = 0.0
var float dolBelowScore = 0.0
var string dolAboveName = ""
var string dolBelowName = ""

// Candidate buffer for the DOL ranking pass. Plain parallel scalars rather than
// objects: the list is rebuilt on every bar and read once, and allocating a
// dozen objects per bar for that is memory churn with nothing to show for it.
var float[] refPx = array.new_float()
var string[] refNm = array.new_string()
var float[] refW = array.new_float()
var int[] refAge = array.new_int()
var bool[] refHigh = array.new_bool()

// Turtle Soup: the raid is staged first and only becomes a pattern once the
// reversal behind it is confirmed.
var int tsPendDir = 0
var int tsPendBar = na
var float tsPendExtreme = na
var float tsPendLevel = na
var string lastTSDir = "None"
var int lastTSBar = na
var float lastTSStop = na

// Judas swing and Power of 3, both reset on the true (New York midnight) day
// rather than on the exchange session, because that is the open the day's range
// is actually built from.
var string judasDir = "None"
var int judasBar = na
var float judasLevel = na
var bool judasDone = false
var string po3Phase = "Accumulation"
var int po3Dir = 0
var float po3ManipLevel = na

// SMT needs only the last two confirmed pivots on each series to answer the one
// question it asks: did both instruments tell the same story at that turn?
var float ourPHNew = na
var float ourPHOld = na
var float cmpPHNew = na
var float cmpPHOld = na
var float ourPLNew = na
var float ourPLOld = na
var float cmpPLNew = na
var float cmpPLOld = na
var string smtDir = "None"
var int smtBar = na
var string smtNote = ""

// Pool / HTF-level / DOL drawing references
var line[] poolLineRefs = array.new<line>()
var label[] poolLabelRefs = array.new<label>()
var line[] htfLineRefs = array.new<line>()
var label[] htfLabelRefs = array.new<label>()
var box[] asiaBoxRefs = array.new<box>()
var line[] asiaLineRefs = array.new<line>()
var label[] asiaLabelRefs = array.new<label>()
var line[] dolLineRefs = array.new<line>()
var label[] dolLabelRefs = array.new<label>()
var line[] timeLineRefs = array.new<line>()
var label[] timeLabelRefs = array.new<label>()
// Judas, Turtle Soup and SMT are drawn on the bar they happen rather than
// redrawn on the last bar — the same treatment structure breaks get, because the
// mark belongs to that candle — so they share one capped pool of labels.
var label[] eventLabelRefs = array.new<label>()

// ── The sniper engine's last verdict ────────────────────────────────────────
// The gate results live in bool arrays rather than a dozen scalars so the
// dashboard can walk them by index and name the first that failed without
// knowing anything about what the gates are. Index order is the cascade order: 0
// HTF bias · 1 intermediate array · 2 dealing-range half · 3 killzone 4
// structure · 5 liquidity taken · 6 SMT · 7 draw on liquidity · 8 confirmed entry
var bool[] gateL = array.new_bool(9, false)
var bool[] gateS = array.new_bool(9, false)
// Cooldowns are per direction. Sharing one bar index meant a long muted every
// short behind it for the whole window, which is not what a cooldown is for: it
// exists to stop the *same* setup being re-signalled, and an opposing setup is
// by definition a different one.
var int lastSniperBarL = na
var int lastSniperBarS = na
// B grade carries its own cooldown so a stream of B markers can never crowd out
// an A+ that forms shortly after one, and so B respects a recent A+ in turn.
var int lastBTierBarL = na
var int lastBTierBarS = na
// The most recent signal of either direction, for the dashboard's "last ▲ 12b".
var int lastSniperBar = na
var int sniperDir = 0
var string sniperModel = ""
var string sniperNarrative = ""
var float sniperScore = 0.0
var float sniperEntry = na
var float sniperSL = na
var float sniperTP1 = na
var float sniperTP2 = na
var float sniperTP3 = na
var float sniperRR = 0.0
// What the engine is currently watching: every gate passed, score short of the
// threshold. This is what makes a quiet chart legible instead of mysterious.
var float watchScoreL = 0.0
var float watchScoreS = 0.0
var string watchModelL = ""
var string watchModelS = ""
var float bestScoreSeen = 0.0
var int cascadePassBars = 0
var int signalCount = 0
// ── Diagnostics ────────────────────────────────────────────────────────────
// Per-gate rejection counts over the whole loaded history, indexed the same way
// as gateL / gateS. Every armed gate that failed on a bar is counted, not just
// the first: the first-failure view is exactly what hid a deadlocked gate pair,
// because a gate downstream of the blocker never gets to report itself.
var int[] gateBlockL = array.new_int(9, 0)
var int[] gateBlockS = array.new_int(9, 0)
// Why setups that cleared every gate still did not fire. Without these the
// cascade tally reads "45 setups, 27 fired" and the missing 18 are unexplained.
var int rejScore = 0
var int rejRR = 0
var int rejCooldown = 0
var int rejStop = 0
var int bTierCount = 0
// ── Armed-entry lifecycle ──────────────────────────────────────────────────
// Where setups go once price reaches the level. `expired` (price sat there and
// never turned) versus `voided` (the array itself failed) versus `confirmed` is
// the distinction that separates a quiet market from a broken engine, and it is
// not answerable from a single "no tap" counter.
//
// Held in an array rather than as four scalars because the functions that
// advance the state machine are the ones that have to count, and a Pine function
// may mutate a global collection but may not reassign a global variable.
// Index 0 armed · 1 confirmed · 2 expired · 3 voided
var int[] armStats = array.new_int(4, 0)
bumpArmStat(int i) =>
    array.set(armStats, i, array.get(armStats, i) + 1)
var label[] sniperLabelRefs = array.new<label>()
var label[] watchLabelRefs = array.new<label>()
var label[] bTierLabelRefs = array.new<label>()





// ===== HELPER FUNCTIONS =====
// Delete-and-clear helpers for tracked drawing objects, so draw functions can
// safely redraw from scratch without accumulating orphaned boxes/labels/lines
clearBoxes(refs) =>
    if array.size(refs) > 0
        for b in refs
            box.delete(b)
        array.clear(refs)

clearLabels(refs) =>
    if array.size(refs) > 0
        for l in refs
            label.delete(l)
        array.clear(refs)

clearLines(refs) =>
    if array.size(refs) > 0
        for ln in refs
            line.delete(ln)
        array.clear(refs)

// Rolling caps: keep the newest N drawings and delete the rest, so structure
// annotations can never consume the 500-object budget needed by SL/TP lines.
capLines(array<line> refs, int maxN) =>
    while array.size(refs) > maxN
        line.delete(array.shift(refs))

capLabels(array<label> refs, int maxN) =>
    while array.size(refs) > maxN
        label.delete(array.shift(refs))

capBoxes(array<box> refs, int maxN) =>
    while array.size(refs) > maxN
        box.delete(array.shift(refs))

// ===== SCORING PRIMITIVES =====
// What survived the removal of the old confluence model. Both of these are
// consumed by the sniper stack, which is now the only scorer in the script.
volSMA = ta.sma(volume, 20)

// Volume confirmation.
scoreVolume() =>
    if na(volSMA) or volSMA == 0
        0.5
    else
        volRatio = volume / volSMA
        if volRatio >= 2.0
            1.0
        else if volRatio >= 1.5
            0.85
        else if volRatio >= 1.0
            0.65
        else if volRatio >= 0.7
            0.4
        else
            0.2

// Power of 3 phase quality. The manipulation leg — stops harvested, price about
// to reverse out of the day's range — is where the algorithm wants to fill you.
// Distribution is the move already delivered, so an entry there is a chase, and
// accumulation is a guess at which way the range breaks.
scorePO3(int dir) =>
    if not showPO3
        0.6
    else if po3Phase == "Manipulation"
        // Only in the direction the manipulation sets up: a sweep of the lows is
        // the setup for a long, and tells a short nothing good.
        po3Dir == dir ? 1.0 : 0.35
    else if po3Phase == "Distribution"
        po3Dir == dir ? 0.5 : 0.25
    else
        0.4

// ===== KILLZONE AWARENESS =====
// The killzone currently live, resolved from the DST-aware time engine above.
// The windows are adjacent rather than overlapping by default, so the overlap
// branch only fires if the user has widened one of them.
getCurrentSession() =>
    inLondonKZ and inNYAMKZ ? "London/NY Overlap" : inNYAMKZ ? "NY AM KZ" : inLondonKZ ? "London KZ" : inLNCloseKZ ? "London Close" : inAsiaKZ ? "Asia KZ" : "Off-KZ"

// The most precise live window, for the dashboard and for signal labels: a macro
// beats the Silver Bullet hour, which beats the killzone containing it.
getActiveWindow() =>
    inMacro ? "MACRO " + macroName : inSilverBullet ? "SB " + sbName : getCurrentSession()

// Background shading follows the same precedence, so the narrow high-precision
// windows stay visible inside the broad killzone blocks they sit in.
getSessionBGColor() =>
    if inMacro and showMacros
        macroBGColor
    else if inSilverBullet and showSilverBullet
        sbBGColor
    else if inLondonKZ and inNYAMKZ
        color.new(color.rgb(0, 200, 100), 92)
    else if inNYAMKZ
        nySessionColor
    else if inLondonKZ
        londonSessionColor
    else if inLNCloseKZ
        lnCloseSessionColor
    else if inAsiaKZ
        asianSessionColor
    else
        na

// ═══════════════════════════════════════════════════════════════════════════
// LIQUIDITY PURGE ENGINE
// ═══════════════════════════════════════════════════════════════════════════
// This one tracks real resting liquidity and requires the two-part ICT sequence:
// trade beyond the level, then close back inside it.

// Merge a newly confirmed pivot into the level registry. Pivots within the
// cluster tolerance are one level with a higher strength (an equal-highs /
// equal-lows pool) rather than several duplicates that each fire their own
// purge.
registerLiqLevel(int idx, float price, bool isHigh, bool major) =>
    tol = sweepClusterATR * volUnit
    merged = false
    for lv in liqLevels
        if lv.isHigh == isHigh and not lv.swept and not lv.broken and na(lv.pierceBar) and math.abs(lv.price - price) <= tol
            lv.strength += 1
            if (isHigh and price > lv.price) or (not isHigh and price < lv.price)
                lv.price := price
                lv.barIdx := idx
                lv.wickExtreme := price
            if major
                lv.major := true
            merged := true
            break
    if not merged
        array.push(liqLevels, LiqLevel.new(price=price, barIdx=idx, firstBar=idx, isHigh=isHigh, major=major, strength=1, swept=false, broken=false, pierceBar=na, wickExtreme=price))
    while array.size(liqLevels) > 120
        array.shift(liqLevels)

// Walk the registry: pierce -> close back inside = purge, pierce -> no return
// inside the confirm window = a genuine break, and the level is retired.
updateLiquidityLevels() =>
    minPierce = sweepMinPierceATR * volUnit
    n = array.size(liqLevels)
    if n > 0
        for idx = 0 to n - 1
            i = n - 1 - idx
            if i < 0
                break
            lv = array.get(liqLevels, i)
            if lv.swept or lv.broken or bar_index - lv.barIdx > levelMaxAge
                array.remove(liqLevels, i)
                continue
            if bar_index <= lv.barIdx
                continue
            if lv.isHigh
                if high > lv.price + minPierce
                    if na(lv.pierceBar)
                        lv.pierceBar := bar_index
                    lv.wickExtreme := math.max(lv.wickExtreme, high)
                if not na(lv.pierceBar)
                    if close < lv.price
                        lv.swept := true
                        array.push(liqSweeps, LiquiditySweep.new(pierceBar=lv.pierceBar, confirmBar=bar_index, sweptLevel=lv.price, wickExtreme=lv.wickExtreme, dir=-1, major=lv.major, invalidated=false))
                    else if bar_index - lv.pierceBar >= sweepConfirmBars
                        lv.broken := true
            else
                if low < lv.price - minPierce
                    if na(lv.pierceBar)
                        lv.pierceBar := bar_index
                    lv.wickExtreme := math.min(lv.wickExtreme, low)
                if not na(lv.pierceBar)
                    if close > lv.price
                        lv.swept := true
                        array.push(liqSweeps, LiquiditySweep.new(pierceBar=lv.pierceBar, confirmBar=bar_index, sweptLevel=lv.price, wickExtreme=lv.wickExtreme, dir=1, major=lv.major, invalidated=false))
                    else if bar_index - lv.pierceBar >= sweepConfirmBars
                        lv.broken := true
    while array.size(liqSweeps) > 60
        array.shift(liqSweeps)

// A purge stays valid as a stop reference until price closes beyond the wick
// that created it — at that point the level was reclaimed, not swept.
cleanPurges() =>
    n = array.size(liqSweeps)
    if n > 0
        for idx = 0 to n - 1
            i = n - 1 - idx
            if i < 0
                break
            s = array.get(liqSweeps, i)
            if bar_index - s.confirmBar > sweepMaxAge
                array.remove(liqSweeps, i)
                continue
            if not s.invalidated
                if s.dir == -1 and close > s.wickExtreme
                    s.invalidated := true
                else if s.dir == 1 and close < s.wickExtreme
                    s.invalidated := true

// Was liquidity taken in this direction within `window` bars? dir +1 = sellside
// purge (lows taken, expect up), -1 = buyside purge.
purgedRecently(int dir, int window) =>
    b = dir == 1 ? livePurgeUpBar : livePurgeDnBar
    not na(b) and bar_index - b <= window

// The furthest wick of the most recent live purge in a direction — the
// invalidation point every reversal model measures its stop from.
purgeStopRef(int dir) =>
    dir == 1 ? livePurgeUpWick : livePurgeDnWick

drawPurges() =>
    clearLabels(sweepLabelRefs)
    clearLines(sweepLineRefs)
    if showLiqSweeps
        for s in liqSweeps
            if bar_index - s.confirmBar <= sweepMaxAge
                isSellside = s.dir == 1
                col = s.invalidated ? color.new(color.gray, 55) : liqSweepColor
                txt = (isSellside ? "▼" : "▲") + (s.major ? " PURGE" : " purge") + (s.invalidated ? " ✕" : "")
                lbl = label.new(s.pierceBar, s.wickExtreme, txt, style=isSellside ? label.style_label_up : label.style_label_down, color=col, textcolor=color.black, size=size.tiny)
                ln = line.new(int(math.max(0, s.pierceBar - 6)), s.sweptLevel, s.confirmBar + 3, s.sweptLevel, color=col, width=2, style=line.style_dotted)
                array.push(sweepLabelRefs, lbl)
                array.push(sweepLineRefs, ln)
        capLabels(sweepLabelRefs, 30)
        capLines(sweepLineRefs, 30)

// ═══════════════════════════════════════════════════════════════════════════
// CISD DRAWING
// ═══════════════════════════════════════════════════════════════════════════
drawCISD() =>
    clearLines(cisdLineRefs)
    clearLabels(cisdLabelRefs)
    if showCISD
        for e in cisdEvents
            if bar_index - e.barIdx <= cisdMaxAge
                isBull = e.dir == 1
                col = isBull ? cisdBullColor : cisdBearColor
                // The CISD level runs from the start of the delivery run it
                // broke
                ln = line.new(e.runStart, e.level, e.barIdx + 3, e.level, color=col, width=2)
                tag = "CISD " + (isBull ? "▲" : "▼") + (e.displaced ? " ✦" : "") + (e.purged ? " ⓟ" : "")
                lbl = label.new(e.barIdx, e.level, tag, style=isBull ? label.style_label_up : label.style_label_down, color=color.new(col, 25), textcolor=color.black, size=size.tiny)
                array.push(cisdLineRefs, ln)
                array.push(cisdLabelRefs, lbl)
        capLines(cisdLineRefs, 30)
        capLabels(cisdLabelRefs, 30)

// ═══════════════════════════════════════════════════════════════════════════
// ZONE ENGINE — ORDER BLOCKS, MITIGATION BLOCKS, BREAKERS
// ═══════════════════════════════════════════════════════════════════════════
// ── Generic constructor for every PD array ───────────────────────────────────
// A zone is only created when a displacement leg *breaks structure*. The origin
// candle is the last opposite-colour candle before that leg, which the delivery
// run tracker already knows: the leg is the run, so the origin sits immediately
// before the run started.
addZone(float zTop, float zBot, string kind, int dir, int cBar, string origin) =>
    bool made = false
    if not na(zTop) and not na(zBot) and zTop - zBot >= syminfo.mintick and not na(cBar)
        dup = false
        for z in zones
            if z.active and z.kind == kind and z.dir == dir
                if z.createdBar == cBar or (math.abs(z.top - zTop) <= tapTol and math.abs(z.bottom - zBot) <= tapTol)
                    dup := true
                    break
        if not dup
            array.push(zones, Zone.new(top=zTop, bottom=zBot, mean=math.avg(zTop, zBot), wickTop=zTop, wickBottom=zBot, kind=kind, dir=dir, touches=0, flipped=false, mitigated=false, active=true, createdBar=int(math.max(0, cBar)), confirmBar=bar_index, lastTouchBar=na, origin=origin))
            made := true
    made

// Quality tier, 1 (weakest) to 5 (Unicorn).
// The penalty starts at the *second* touch, not the first. updateZones() runs
// earlier in the bar than the entry engine and has already counted the arriving
// tap, so penalising `touches > 0` charged every pristine first-touch block the
// used-zone discount on its own entry bar — a fifth off the largest weight in
// the stack, applied to exactly the setups worth taking. A zone's first retest
// is also its highest-probability test, so this is the correct reading twice
// over.
zoneTier(Zone z) =>
    base = z.kind == "Unicorn" ? 5 : z.kind == "BPR" or z.kind == "Breaker" or z.kind == "Propulsion" ? 4 : z.kind == "OB" or z.kind == "IFVG" ? 3 : z.kind == "Mitigation" or z.kind == "Rejection" ? 2 : 1
    int tier = base - (z.touches > 1 ? 1 : 0)
    tier < 1 ? 1 : tier

tierStars(int t) =>
    t >= 5 ? "★★★★★" : t == 4 ? "★★★★" : t == 3 ? "★★★" : t == 2 ? "★★" : "★"

// Whether a zone's kind is currently switched on for drawing.
zoneVisible(Zone z) =>
    z.kind == "Mitigation" ? showMitigationBlocks : z.kind == "Breaker" ? showBreakers : z.kind == "IFVG" ? showIFVG : z.kind == "BPR" ? showBPR : z.kind == "Unicorn" ? showUnicorn : z.kind == "Propulsion" ? showPropulsion : z.kind == "Rejection" ? showRejectionBlocks : z.kind == "VI" ? showVI : (z.kind == "NDOG" or z.kind == "NWOG") ? showOG : true

// ── Rejection blocks ─────────────────────────────────────────────────────────
// The wick of a pivot candle that speared liquidity and was thrown straight
// back. The block is the wick alone — body extreme to wick extreme — because the
// body is the range the algorithm was comfortable delivering in and the wick is
// the range it was not.
tryRejectionBlock(int off, bool isHigh) =>
    if showRejectionBlocks and off >= 0 and off <= bar_index and off <= 450
        rng = high[off] - low[off]
        if rng > 0
            bodyTop = math.max(open[off], close[off])
            bodyBot = math.min(open[off], close[off])
            wick = isHigh ? high[off] - bodyTop : bodyBot - low[off]
            if wick >= rbWickRatio * rng and wick >= rbMinWickATR * volUnit
                float rTop = isHigh ? high[off] : bodyBot
                float rBot = isHigh ? bodyTop : low[off]
                addZone(rTop, rBot, "Rejection", isHigh ? -1 : 1, bar_index - off, isHigh ? "wick ▼" : "wick ▲")

findZoneOrigin(int runStartBar, bool wantDownCandle) =>
    int resOff = -1
    startOff = na(runStartBar) ? 1 : math.max(1, bar_index - runStartBar + 1)
    if startOff <= zoneOriginLookback + 1
        for k = 0 to zoneOriginLookback - 1
            off = startOff + k
            if off > bar_index or off > 450
                break
            if wantDownCandle and close[off] < open[off]
                resOff := off
                break
            if not wantDownCandle and close[off] > open[off]
                resOff := off
                break
    resOff

// The ICT distinction between the two block types: an order block's leg takes
// out prior liquidity on its way to the reversal, a mitigation block's does not.
legTookLiquidity(int off, bool bullish) =>
    float legExt = bullish ? low[off] : high[off]
    for k = 0 to off - 1
        legExt := bullish ? math.min(legExt, low[k]) : math.max(legExt, high[k])
    float priorExt = bullish ? low[off + 1] : high[off + 1]
    for k = 2 to zoneLiqWindow
        o2 = off + k
        if o2 > bar_index
            break
        priorExt := bullish ? math.min(priorExt, low[o2]) : math.max(priorExt, high[o2])
    na(priorExt) ? false : bullish ? legExt < priorExt : legExt > priorExt

createZone(int off, int dir, string origin) =>
    if off >= 1 and off <= bar_index
        oBar = bar_index - off
        dup = false
        for z in zones
            if z.active and z.createdBar == oBar and z.dir == dir
                dup := true
                break
        if not dup
            wTop = high[off]
            wBot = low[off]
            bodyTop = math.max(open[off], close[off])
            bodyBot = math.min(open[off], close[off])
            float zTop = zoneUseWicks ? wTop : bodyTop
            float zBot = zoneUseWicks ? wBot : bodyBot
            // A doji origin would give a zero-height zone, so fall back to its
            // range
            if zTop - zBot < syminfo.mintick
                zTop := wTop
                zBot := wBot
            // The leg away from the origin candle is what makes it an order
            // block
            legSpan = dir == 1 ? high - low[off] : high[off] - low
            if zTop > zBot and legSpan >= zoneMinImpulseATR * volUnit
                tookLiq = legTookLiquidity(off, dir == 1)
                // A block that forms inside a live block of the same direction
                // is a propulsion block: the algorithm coming back to its own
                // level to continue delivery rather than to reverse off it.
                // Scanned here, before the push, so `zones` is never mutated
                // mid-loop.
                nested = false
                if showPropulsion
                    for zp in zones
                        if zp.active and zp.dir == dir and (zp.kind == "OB" or zp.kind == "Breaker" or zp.kind == "Propulsion") and zTop >= zp.bottom and zBot <= zp.top
                            nested := true
                            break
                kindTag = nested ? "Propulsion" : tookLiq ? "OB" : "Mitigation"
                array.push(zones, Zone.new(top=zTop, bottom=zBot, mean=math.avg(zTop, zBot), wickTop=wTop, wickBottom=wBot, kind=kindTag, dir=dir, touches=0, flipped=false, mitigated=false, active=true, createdBar=oBar, confirmBar=bar_index, lastTouchBar=na, origin=origin))

// Lifecycle: freshness, touch counting, and the Breaker transition. A violated
// zone only becomes a Breaker if structure confirmed the new direction — failed
// supply turning into demand.
updateZones() =>
    // Drawing is still capped at maxZones; this only bounds memory.
    while array.size(zones) > maxZones * 6
        array.shift(zones)

    n = array.size(zones)
    if n > 0
        for idx = 0 to n - 1
            i = n - 1 - idx
            if i < 0
                break
            z = array.get(zones, i)
            if not z.active or bar_index - z.confirmBar > zoneMaxAge
                array.remove(zones, i)
                continue
            if bar_index <= z.confirmBar
                continue

            structFresh = not na(lastAnyStructBar) and bar_index - lastAnyStructBar <= breakerWindow
            // Opening gaps are reference levels rather than tradeable blocks
            // that get spent: price passes back and forth through an NWOG all
            // week and the level still draws price. They age out; they are never
            // violated and never exhausted by touches.
            isRef = z.kind == "NDOG" or z.kind == "NWOG"
            violated = not isRef and (z.dir == 1 ? close < z.bottom : close > z.top)

            if violated
                // A violated zone only becomes a Breaker if structure confirmed
                // the new direction — failed supply turning into demand. Without
                // that confirmation the zone is simply spent.
                canFlip = not z.flipped and showBreakers and (z.kind == "OB" or z.kind == "Propulsion") and structFresh and lastAnyStructDir == (z.dir == 1 ? "Bearish" : "Bullish")
                if canFlip
                    z.kind := "Breaker"
                    z.dir := -z.dir
                    z.flipped := true
                    z.touches := 0
                    z.lastTouchBar := bar_index
                    z.origin := z.dir == 1 ? "flip ▲" : "flip ▼"
                    // The breaker gets its own lifetime from the flip onwards
                    z.confirmBar := bar_index
                    // Announce the flip so the Unicorn pass can pair it against
                    // the gaps that already exist on this bar.
                    array.set(flipFlag, 0, bar_index)
                else
                    z.mitigated := true
                    z.active := false
                continue

            // One touch per distinct return, so sitting inside a zone for ten
            // bars is not counted as ten separate tests of it.
            inContact = low <= z.top + tapTol and high >= z.bottom - tapTol
            if inContact
                if na(z.lastTouchBar) or z.lastTouchBar < bar_index - 1
                    z.touches += 1
                z.lastTouchBar := bar_index
            if z.touches > zoneMaxTouches and not isRef
                z.active := false

zoneColorFor(Zone z) =>
    z.kind == "Unicorn" ? (z.dir == 1 ? unicornBullColor : unicornBearColor) : z.kind == "BPR" ? (z.dir == 1 ? bprBullColor : bprBearColor) : z.kind == "IFVG" ? (z.dir == 1 ? ifvgBullColor : ifvgBearColor) : z.kind == "Propulsion" ? (z.dir == 1 ? propBullColor : propBearColor) : z.kind == "Rejection" ? (z.dir == 1 ? rejBullColor : rejBearColor) : z.kind == "VI" ? viZoneColor : (z.kind == "NDOG" or z.kind == "NWOG") ? ogZoneColor : z.kind == "Breaker" ? (z.dir == 1 ? breakerBullColor : breakerBearColor) : z.kind == "Mitigation" ? (z.dir == 1 ? mitigationBullColor : mitigationBearColor) : (z.dir == 1 ? obBullColor : obBearColor)

drawZones() =>
    clearBoxes(zoneBoxRefs)
    clearLabels(zoneLabelRefs)
    clearLines(zoneLineRefs)
    if showZones
        drawn = 0
        n = array.size(zones)
        if n > 0
            // Two passes, high tier first, so the maxZones cap can never discard
            // a live Unicorn or BPR in favour of a stale volume imbalance that
            // merely happens to be newer.
            for pass = 0 to 1
                if drawn >= maxZones
                    break
                for idx = 0 to n - 1
                    i = n - 1 - idx
                    if i < 0 or drawn >= maxZones
                        break
                    z = array.get(zones, i)
                    if not z.active or not zoneVisible(z)
                        continue
                    tier = zoneTier(z)
                    if (pass == 0 and tier < 4) or (pass == 1 and tier >= 4)
                        continue
                    bg = zoneColorFor(z)
                    // Fresh zones get a solid, heavier border; used zones fade
                    // back
                    bx = box.new(z.createdBar, z.top, bar_index, z.bottom, bgcolor=bg, border_color=color.new(bg, 25), border_width=z.touches == 0 ? 2 : 1, border_style=z.touches == 0 ? line.style_solid : line.style_dashed)
                    array.push(zoneBoxRefs, bx)
                    // The mean threshold is the consequent encroachment of the
                    // zone: the level entries are taken at, on every kind.
                    if zoneShowMean
                        array.push(zoneLineRefs, line.new(z.createdBar, z.mean, bar_index, z.mean, color=zoneMeanColor, width=1, style=line.style_dotted))
                    freshTag = z.touches == 0 ? "✦ fresh" : str.tostring(z.touches) + "t"
                    lbl = label.new(bar_index, z.dir == 1 ? z.bottom : z.top, z.kind + " " + (z.dir == 1 ? "▲" : "▼") + " " + tierStars(tier) + " " + freshTag + " | " + z.origin, style=label.style_label_left, color=color.new(bg, 15), textcolor=color.white, size=size.tiny)
                    array.push(zoneLabelRefs, lbl)
                    drawn += 1

// ═══════════════════════════════════════════════════════════════════════════
// QUASIMODO
// ═══════════════════════════════════════════════════════════════════════════
cleanQM() =>
    n = array.size(qmPatterns)
    if n > 0
        for idx = 0 to n - 1
            i = n - 1 - idx
            if i < 0
                break
            q = array.get(qmPatterns, i)
            if bar_index - q.barIdx > qmMaxAge
                array.remove(qmPatterns, i)
                continue
            // Trading beyond the Head voids the pattern
            if q.active
                if q.dir == -1 and close > q.head
                    q.active := false
                else if q.dir == 1 and close < q.head
                    q.active := false
    while array.size(qmPatterns) > 20
        array.shift(qmPatterns)

drawQM() =>
    clearLines(qmLineRefs)
    clearLabels(qmLabelRefs)
    if showQM
        for q in qmPatterns
            if bar_index - q.barIdx <= qmMaxAge
                isBull = q.dir == 1
                col = q.active ? (isBull ? qmBullColor : qmBearColor) : color.new(color.gray, 55)
                // QML = entry, Head = invalidation, Leg = first objective
                array.push(qmLineRefs, line.new(q.lsBar, q.qml, bar_index, q.qml, color=col, width=2))
                array.push(qmLineRefs, line.new(q.headBar, q.head, bar_index, q.head, color=color.new(col, 55), width=1, style=line.style_dashed))
                array.push(qmLineRefs, line.new(q.legBar, q.leg, bar_index, q.leg, color=color.new(col, 55), width=1, style=line.style_dotted))
                array.push(qmLabelRefs, label.new(q.barIdx, q.qml, "QM " + (isBull ? "▲" : "▼") + " QML" + (q.active ? "" : " ✕"), style=isBull ? label.style_label_up : label.style_label_down, color=color.new(col, 20), textcolor=color.white, size=size.tiny))
        // Three lines per pattern, so the cap is a multiple of three
        capLines(qmLineRefs, 45)
        capLabels(qmLabelRefs, 15)

// ═══════════════════════════════════════════════════════════════════════════
// COMPOSITE PD ARRAYS — BALANCED PRICE RANGE AND UNICORN
// ═══════════════════════════════════════════════════════════════════════════
// Both are intersections rather than new detections: a band that two independent
// arrays agree on. They are only evaluated on the bars where one of their
// ingredients appears — a new gap, or a breaker flipping — so the nested scans
// never become a per-bar cost.

// A bullish and a bearish FVG that overlap. The overlap itself is the array:
// price delivered inefficiently in both directions through the same band, and it
// is the newer gap that sets the direction because that is the leg that
// reversed.
pairBPR(FVG f, int dir, array<FVG> opp) =>
    float bTop = na
    float bBot = na
    int bBar = na
    minOv = bprMinOverlapATR * volUnit
    n = array.size(opp)
    if n > 0
        for idx = 0 to n - 1
            o = array.get(opp, n - 1 - idx)
            if o.mitigated or math.abs(o.creation_bar_idx - f.creation_bar_idx) > bprWindow
                continue
            ovTop = math.min(f.top, o.top)
            ovBot = math.max(f.bottom, o.bottom)
            if ovTop - ovBot >= minOv
                bTop := ovTop
                bBot := ovBot
                bBar := int(math.min(f.start_idx, o.start_idx))
                break
    // Pushed after the scan, never during it.
    if not na(bTop)
        addZone(bTop, bBot, "BPR", dir, bBar, dir == 1 ? "BPR ▲" : "BPR ▼")

// Unicorn: a breaker block overlapping a same-direction FVG. The breaker says
// structure failed and reversed, the gap says the reversal was delivered with
// displacement, and the band they share is where both statements are true.
pairUnicornForFVG(FVG f, int dir) =>
    float uTop = na
    float uBot = na
    int uBar = na
    n = array.size(zones)
    if n > 0
        for idx = 0 to n - 1
            z = array.get(zones, n - 1 - idx)
            if not z.active or z.kind != "Breaker" or z.dir != dir or bar_index - z.confirmBar > unicornWindow
                continue
            ovTop = math.min(f.top, z.top)
            ovBot = math.max(f.bottom, z.bottom)
            if ovTop - ovBot >= syminfo.mintick
                uTop := ovTop
                uBot := ovBot
                uBar := int(math.min(f.start_idx, z.createdBar))
                break
    if not na(uTop)
        addZone(uTop, uBot, "Unicorn", dir, uBar, dir == 1 ? "Unicorn ▲" : "Unicorn ▼")

// The mirror pass, run on the bar a zone flips to Breaker: the gap it overlaps
// usually predates the flip, so it would never be found by the pass above.
pairUnicornForBreaker(array<FVG> fvgs, int dir) =>
    float bTop = na
    float bBot = na
    int bBar = na
    nz2 = array.size(zones)
    if nz2 > 0
        for idx = 0 to nz2 - 1
            z = array.get(zones, nz2 - 1 - idx)
            if z.active and z.kind == "Breaker" and z.dir == dir and z.confirmBar == bar_index
                bTop := z.top
                bBot := z.bottom
                bBar := z.createdBar
                break
    float uTop = na
    float uBot = na
    int uBar = na
    if not na(bTop)
        nf = array.size(fvgs)
        if nf > 0
            for idx = 0 to nf - 1
                f = array.get(fvgs, nf - 1 - idx)
                if f.mitigated or bar_index - f.creation_bar_idx > unicornWindow
                    continue
                ovTop = math.min(f.top, bTop)
                ovBot = math.max(f.bottom, bBot)
                if ovTop - ovBot >= syminfo.mintick
                    uTop := ovTop
                    uBot := ovBot
                    uBar := int(math.min(f.start_idx, bBar))
                    break
    if not na(uTop)
        addZone(uTop, uBot, "Unicorn", dir, uBar, dir == 1 ? "Unicorn ▲" : "Unicorn ▼")

// ═══════════════════════════════════════════════════════════════════════════
// OTE BAND AND STANDARD DEVIATION PROJECTIONS
// ═══════════════════════════════════════════════════════════════════════════
// The band is drawn on the current impulse leg and the projections are that same
// leg measured forward past its own extreme, which is what replaces the old
// 0.75R / 1.5R partials with objectives the market itself defined.
drawOTE() =>
    clearBoxes(oteBoxRefs)
    clearLines(oteLineRefs)
    clearLabels(oteLabelRefs)
    if oteValid
        leftBar = int(math.max(0, math.min(nz(swingHighBar, bar_index - 50), nz(swingLowBar, bar_index - 50))))
        if showOTE
            bandTop = math.max(ote62, ote79)
            bandBot = math.min(ote62, ote79)
            array.push(oteBoxRefs, box.new(leftBar, bandTop, bar_index, bandBot, bgcolor=oteBandColor, border_color=color.new(oteLineColor, 70), border_width=1))
            array.push(oteLineRefs, line.new(leftBar, ote705, bar_index, ote705, color=oteLineColor, width=1))
            array.push(oteLabelRefs, label.new(bar_index, ote705, "OTE .705 " + (oteDir == 1 ? "▲" : "▼"), style=label.style_label_left, color=color.new(oteLineColor, 25), textcolor=color.black, size=size.tiny))
        if showSDProj
            array.push(oteLineRefs, line.new(leftBar, sd05, bar_index, sd05, color=color.new(sdProjColor, 55), width=1, style=line.style_dotted))
            array.push(oteLineRefs, line.new(leftBar, sd10, bar_index, sd10, color=sdProjColor, width=1, style=line.style_dashed))
            array.push(oteLineRefs, line.new(leftBar, sd20, bar_index, sd20, color=color.new(sdProjColor, 35), width=1, style=line.style_dotted))
            array.push(oteLabelRefs, label.new(bar_index, sd10, "-1 SD", style=label.style_label_left, color=color.new(sdProjColor, 25), textcolor=color.black, size=size.tiny))
            array.push(oteLabelRefs, label.new(bar_index, sd20, "-2 SD", style=label.style_label_left, color=color.new(sdProjColor, 45), textcolor=color.black, size=size.tiny))

// ═══════════════════════════════════════════════════════════════════════════
// LIQUIDITY POOLS, HTF LEVELS AND THE DRAW ON LIQUIDITY
// ═══════════════════════════════════════════════════════════════════════════
// Nothing new has to be detected — the pool was already there, unnamed.

// One event label, drawn on the bar the event happened, sharing a capped pool.
eventLabel(int bIdx, float px, string txt, color col, bool up) =>
    lb = label.new(bIdx, px, txt, style=up ? label.style_label_up : label.style_label_down, color=color.new(col, 15), textcolor=color.white, size=size.tiny)
    array.push(eventLabelRefs, lb)
    capLabels(eventLabelRefs, 18)

// ── Magnetism ────────────────────────────────────────────────────────────────
// Every unswept pool is a candidate objective; the question is which one price
// is actually being delivered towards. Five independent terms:
//   base       what kind of level it is — a previous month high outranks an
//              internal pivot by a wide margin
//   cluster    how many pivots built it: an equal-highs pool is a stack of stops
//   age        liquidity that has rested untouched for longer is worth more
//   proximity  near levels pull harder, decaying smoothly
//   bias       premium/discount position and swing trend tilt the ranking, which
//              is what stops the engine naming a target behind price
// Inside dolMinDistATR is already in reach and not worth a trade; past
// dolMaxDistATR is scenery.
poolMagnetism(float px, bool isHigh, float baseW, int ageBars, int strength) =>
    float sc = 0.0
    dist = math.abs(px - close) / math.max(volUnit, syminfo.mintick)
    if dist >= dolMinDistATR and dist <= dolMaxDistATR
        prox = 26.0 * math.exp(-dist / 8.0)
        cluster = math.min(18.0, math.max(0, strength - 1) * 7.0)
        age = math.min(12.0, nz(ageBars) / 40.0)
        float bias = 0.0
        // In premium the draw is the sellside below, in discount the buyside
        // above — the same rule that forbids buying premium in the first place.
        if not na(drEq)
            bias += (isHigh ? (inDiscount ? dolBiasWeight : -dolBiasWeight) : (inPremium ? dolBiasWeight : -dolBiasWeight)) * 0.5
        if swingTrend != 0
            bias += (isHigh ? (swingTrend == 1 ? dolBiasWeight : -dolBiasWeight) : (swingTrend == -1 ? dolBiasWeight : -dolBiasWeight)) * 0.5
        sc := math.max(0.0, baseW + prox + cluster + age + bias)
    sc

// Add one fixed reference level (PDH/PDL, PWH/PWL, PMH/PML, Asian range edge) to
// the DOL candidate buffer. Functions may mutate a global collection, which is
// what lets this stay a one-line call per level instead of five parallel pushes.
pushRef(float px, string nm, float w, int ageBars, bool isHigh) =>
    if not na(px) and (isHigh ? px > close : px < close)
        array.push(refPx, px)
        array.push(refNm, nm)
        array.push(refW, w)
        array.push(refAge, nz(ageBars))
        array.push(refHigh, isHigh)

// ── Drawing ──────────────────────────────────────────────────────────────────
drawLiqPools() =>
    clearLines(poolLineRefs)
    clearLabels(poolLabelRefs)
    if showEQ
        drawn = 0
        n = array.size(liqLevels)
        if n > 0
            for idx = 0 to n - 1
                if drawn >= poolMaxDrawn
                    break
                lv = array.get(liqLevels, n - 1 - idx)
                if lv.swept or lv.broken or lv.strength < eqMinStrength
                    continue
                col = lv.isHigh ? eqhColor : eqlColor
                left = int(math.max(0, nz(lv.firstBar, lv.barIdx)))
                array.push(poolLineRefs, line.new(left, lv.price, bar_index + 4, lv.price, color=color.new(col, 25), width=2, style=line.style_dashed))
                array.push(poolLabelRefs, label.new(bar_index + 4, lv.price, (lv.isHigh ? "EQH" : "EQL") + " ×" + str.tostring(lv.strength), style=label.style_label_left, color=color.new(col, 20), textcolor=color.black, size=size.tiny))
                drawn += 1

// Previous day / week / month extremes. These are the levels every desk on the
// planet can see, which is exactly why price is drawn to them.
pushHTFLevel(float px, string nm, color col) =>
    if not na(px)
        left = int(math.max(0, bar_index - 120))
        array.push(htfLineRefs, line.new(left, px, bar_index + 4, px, color=col, width=1, style=line.style_dotted))
        array.push(htfLabelRefs, label.new(bar_index + 4, px, nm, style=label.style_label_left, color=color.new(col, 30), textcolor=color.black, size=size.tiny))

drawHTFLevels() =>
    clearLines(htfLineRefs)
    clearLabels(htfLabelRefs)
    if showPDHL
        pushHTFLevel(pdhRaw, "PDH", pdhlColor)
        pushHTFLevel(pdlRaw, "PDL", pdhlColor)
    if showPWHL
        pushHTFLevel(pwhRaw, "PWH", pwhlColor)
        pushHTFLevel(pwlRaw, "PWL", pwhlColor)
    if showPMHL
        pushHTFLevel(pmhRaw, "PMH", pmhlColor)
        pushHTFLevel(pmlRaw, "PML", pmhlColor)

// The box covers the session that built the range; the two edges then project
// forward on their own, because what matters after Asia closes is not the block
// of time but the two levels London and New York will run.
drawAsiaRange() =>
    clearBoxes(asiaBoxRefs)
    clearLines(asiaLineRefs)
    clearLabels(asiaLabelRefs)
    if showAsianRange and not na(asiaHigh) and not na(asiaLow)
        l = int(math.max(0, nz(asiaStartBar, bar_index - 20)))
        r = int(math.max(l + 1, nz(asiaEndBar, bar_index)))
        array.push(asiaBoxRefs, box.new(l, asiaHigh, r, asiaLow, bgcolor=asiaRangeColor, border_color=color.new(asiaRangeColor, 35), border_width=1))
        array.push(asiaLineRefs, line.new(r, asiaHigh, bar_index + 4, asiaHigh, color=color.new(asiaRangeColor, 25), width=1, style=line.style_dotted))
        array.push(asiaLineRefs, line.new(r, asiaLow, bar_index + 4, asiaLow, color=color.new(asiaRangeColor, 25), width=1, style=line.style_dotted))
        array.push(asiaLabelRefs, label.new(int(math.avg(l, r)), asiaHigh, "Asian Range " + str.tostring(asiaHigh - asiaLow, format.mintick), style=label.style_label_down, color=color.new(asiaRangeColor, 20), textcolor=color.white, size=size.tiny))

// The True Day Open, and the winning draw on liquidity with its runner-up on the
// far side for context — one thick line for where price is going, one faint one
// for what it would have to pass through to go the other way.
drawTimeAndDOL() =>
    clearLines(timeLineRefs)
    clearLabels(timeLabelRefs)
    clearLines(dolLineRefs)
    clearLabels(dolLabelRefs)
    if showTDO and not na(trueDayOpen)
        left = int(math.max(0, nz(tdoBar, bar_index - 50)))
        array.push(timeLineRefs, line.new(left, trueDayOpen, bar_index + 4, trueDayOpen, color=color.new(tdoColor, 20), width=1))
        array.push(timeLabelRefs, label.new(bar_index + 4, trueDayOpen, "TDO " + (tdoBiasUp ? "▲" : "▼"), style=label.style_label_left, color=color.new(tdoColor, 25), textcolor=color.black, size=size.tiny))
    if showDOL
        if not na(dolPx)
            col = dolDir == 1 ? dolUpColor : dolDnColor
            left = int(math.max(0, bar_index - 80))
            array.push(dolLineRefs, line.new(left, dolPx, bar_index + 12, dolPx, color=col, width=3))
            array.push(dolLabelRefs, label.new(bar_index + 12, dolPx, "◀ DOL " + dolName + " " + str.tostring(dolPx, format.mintick), style=label.style_label_left, color=color.new(col, 15), textcolor=color.black, size=size.small))
        // The opposite side, faint: the counter-objective, and the reason a
        // signal against the draw has to clear a higher bar to be worth taking.
        altPx = dolDir == 1 ? dolBelowPx : dolAbovePx
        altNm = dolDir == 1 ? dolBelowName : dolAboveName
        if not na(altPx) and dolDir != 0
            altCol = dolDir == 1 ? dolDnColor : dolUpColor
            array.push(dolLineRefs, line.new(int(math.max(0, bar_index - 40)), altPx, bar_index + 12, altPx, color=color.new(altCol, 65), width=1, style=line.style_dashed))
            array.push(dolLabelRefs, label.new(bar_index + 12, altPx, altNm, style=label.style_label_left, color=color.new(altCol, 60), textcolor=color.white, size=size.tiny))

// ===== FVG DETECTION AND MANAGEMENT =====
// t0 and t2 are the timestamps of the third and first candle of the gap. Writes
// into two buffers the caller owns rather than allocating a fresh pair every
// bar.
detectFVGs(h, l, c, o, tf, barIdx, gapThreshold, t2, t0, array<FVG> outBull, array<FVG> outBear) =>
    array.clear(outBull)
    array.clear(outBear)

    minGap = math.max(nz(gapThreshold), syminfo.mintick)

    if nz(barIdx) >= 2
        if detectBISI
            gapUp = nz(l[0]) - nz(h[2])
            if gapUp >= minGap
                variant = "Perfect"
                if nz(c[0]) > nz(h[1])
                    variant := "Breakaway"
                else if (nz(h[0]) - nz(l[0])) > 0 and nz(c[0]) < nz(l[0]) + (nz(h[0]) - nz(l[0])) * 0.3
                    variant := "Rejection"
                newFVG = FVG.new(start_idx=barIdx - 2, candle3_idx=barIdx, start_time=int(nz(t2)), candle3_time=int(nz(t0)), top=nz(l[0]), bottom=nz(h[2]), fvgType="BISI", fvgVariant=variant, mitigated=false, mitigatedBar=na, timeframe=tf, creation_bar_idx=barIdx)
                array.push(outBull, newFVG)

        if detectSIBI
            gapDn = nz(l[2]) - nz(h[0])
            if gapDn >= minGap
                variant = "Perfect"
                if nz(c[0]) < nz(l[1])
                    variant := "Breakaway"
                else if (nz(h[0]) - nz(l[0])) > 0 and nz(c[0]) > nz(h[0]) - (nz(h[0]) - nz(l[0])) * 0.3
                    variant := "Rejection"
                newFVG = FVG.new(start_idx=barIdx - 2, candle3_idx=barIdx, start_time=int(nz(t2)), candle3_time=int(nz(t0)), top=nz(l[2]), bottom=nz(h[0]), fvgType="SIBI", fvgVariant=variant, mitigated=false, mitigatedBar=na, timeframe=tf, creation_bar_idx=barIdx)
                array.push(outBear, newFVG)
    array.size(outBull) + array.size(outBear)

processAndCleanFVGs(fvgArray, currentLow, currentHigh) =>
    // Trim down to the cap in one pass.
    while array.size(fvgArray) > maxTrackedFVGs
        array.shift(fvgArray)

    ifvgDepth = ifvgPierceATR * volUnit
    size = array.size(fvgArray)
    if size > 0
        for idx = 0 to size - 1
            i = size - 1 - idx
            if i < 0
                break
            fvg = array.get(fvgArray, i)
            if bar_index - fvg.creation_bar_idx > fvgMaxAge
                array.remove(fvgArray, i)
                continue

            // ── Inversion (IFVG) ────────────────────────────────────────────
            // A body closing clean through the far edge has not filled the gap,
            // it has failed it: the array flips polarity and is re-published as
            // a zone facing the other way. Checked before mitigation, because
            // the normal sequence is fill first and invert afterwards — which is
            // also why a mitigated gap is kept in the array below instead of
            // being deleted the moment it is tagged.
            if showIFVG and canDetect and bar_index > fvg.candle3_idx
                inverted = fvg.fvgType == "BISI" ? close < fvg.bottom - ifvgDepth : close > fvg.top + ifvgDepth
                if inverted
                    addZone(fvg.top, fvg.bottom, "IFVG", fvg.fvgType == "BISI" ? -1 : 1, fvg.start_idx, "inv " + fvg.timeframe)
                    // The gap is consumed: it is a Zone now, not an FVG.
                    array.remove(fvgArray, i)
                    continue

            if not fvg.mitigated
                isMitigated = false
                gapHeight = fvg.top - fvg.bottom

                // Depth 0.5 = Consequent Encroachment, the ICT standard.
                if fvg.fvgType == "BISI"
                    penetrationPoint = fvg.top - gapHeight * mitigationDepth
                    isMitigated := currentLow <= penetrationPoint
                else if fvg.fvgType == "SIBI"
                    penetrationPoint = fvg.bottom + gapHeight * mitigationDepth
                    isMitigated := currentHigh >= penetrationPoint

                if isMitigated
                    fvg.mitigated := true
                    fvg.mitigatedBar := bar_index
                    // Deliberately not removed when showMitigated is off. A
                    // filled gap is still a candidate for inversion, and the
                    // drawing pass already skips mitigated gaps, so keeping it
                    // costs nothing visually and preserves the IFVG path.

// ===== DRAWING FUNCTIONS =====
// One pass over one side. The two halves were near-identical and drifted apart
// as each was edited, so the direction is a parameter now.
drawFVGSide(array<FVG> fvgs, bool isBull) =>
    baseColor = isBull ? bullishFVGColor : bearishFVGColor
    baseBorder = isBull ? bullishFVGBorderColor : bearishFVGBorderColor
    for fvg in fvgs
        if fvg.mitigated and not showMitigated
            continue
        boxColor = baseColor
        currentAlpha = 60
        if fvg.mitigated
            currentAlpha := mitigatedAlpha
        else if fvg.fvgVariant == "Perfect"
            boxColor := perfectFVGColor
        else if fvg.fvgVariant == "Breakaway"
            boxColor := breakawayFVGColor
        else if fvg.fvgVariant == "Rejection"
            boxColor := rejectionFVGColor

        boxBgColor = color.new(boxColor, currentAlpha)
        boxBorderColor = color.new(baseBorder, fvg.mitigated ? mitigatedAlpha : 20)
        // Time coordinates keep HTF zones anchored to the bars they belong to.
        right_time = extendFVG ? time : fvg.candle3_time
        if right_time < fvg.candle3_time
            right_time := fvg.candle3_time
        // A gap the intermediate term also left is the one worth seeing from
        // across the chart, so that is what earns the heavier border.
        borderWidth = fvg.timeframe != timeframe.period ? 2 : 1
        array.push(fvgBoxRefs, box.new(fvg.start_time, fvg.top, right_time, fvg.bottom, xloc=xloc.bar_time, bgcolor=boxBgColor, border_color=boxBorderColor, border_width=borderWidth))

        // Consequent encroachment — the gap's 50% line, which is the level
        // entries are actually armed and confirmed at rather than the far edge.
        if showFVGCE and not fvg.mitigated
            ceLvl = math.avg(fvg.top, fvg.bottom)
            array.push(fvgCELineRefs, line.new(fvg.start_time, ceLvl, right_time, ceLvl, xloc=xloc.bar_time, color=ceLineColor, width=1, style=line.style_dotted))

        // HTF timeframe label
        if fvg.timeframe != timeframe.period
            labelText = fvg.timeframe + "\n" + fvg.fvgVariant
            anchor = isBull ? fvg.top : fvg.bottom
            array.push(fvgLabelRefs, label.new(fvg.candle3_time, anchor, labelText, xloc=xloc.bar_time, style=isBull ? label.style_label_down : label.style_label_up, color=color.new(color.gray, 20), textcolor=color.white, size=size.tiny))

drawFVGs() =>
    clearBoxes(fvgBoxRefs)
    clearLabels(fvgLabelRefs)
    clearLines(fvgCELineRefs)
    drawFVGSide(bullishFVGs, true)
    drawFVGSide(bearishFVGs, false)
    // Cap the oldest away to keep headroom: with every slider at maximum the
    // tracked label total lands just under 500.
    capBoxes(fvgBoxRefs, 240)
    capLabels(fvgLabelRefs, 35)
    // The CE lines share the 500-line budget with SL/TP, structure, zone means
    // and the SD projections, so only the newest gaps keep theirs.
    capLines(fvgCELineRefs, 40)


// ===== RISK MANAGEMENT =====
// The drawn level set that travels with a fired signal. An indicator cannot
// hold, size or exit a position, so nothing here pretends to manage one: the
// lines are extended while the trade would still be open and deleted once price
// has reached the stop or the final objective.
updateRiskManagementLines() =>
    if array.size(riskLevels) > 0
        for i = array.size(riskLevels) - 1 to 0
            r = array.get(riskLevels, i)

            // The entry bar is excluded from the hit test. The fill is at that
            // bar's close, so the wick that tapped the array — the very move
            // that produced the signal — must not be allowed to stop the trade
            // out before it has begun.
            if r.active and bar_index > r.entryBarIdx
                hit = r.signalType == "BUY" ? (high >= r.tpPrice or low <= r.slPrice) : (low <= r.tpPrice or high >= r.slPrice)
                if hit
                    r.active := false

            if bar_index - r.entryBarIdx > 200 or not r.active
                line.delete(r.slLine)
                line.delete(r.tpLine)
                line.delete(r.partialLine)
                line.delete(r.partialLine2)
                line.delete(r.partialLine3)
                array.remove(riskLevels, i)
                continue

            if r.lastBarDrawn != bar_index
                line.set_x2(r.slLine, bar_index)
                line.set_x2(r.tpLine, bar_index)
                line.set_x2(r.partialLine, bar_index)
                line.set_x2(r.partialLine2, bar_index)
                line.set_x2(r.partialLine3, bar_index)
                r.lastBarDrawn := bar_index


// ═══════════════════════════════════════════════════════════════════════════
// SNIPER ENGINE
// ═══════════════════════════════════════════════════════════════════════════
// Two stages, and the order matters. Stage A is a top-down cascade of hard
// gates: HTF bias, intermediate array, dealing-range half, killzone, structure
// state, liquidity taken, SMT, draw on liquidity, and finally a live array being
// tapped.

// ── Gate 1: an intermediate-timeframe array pointing the same way ────────────
// A chart-timeframe gap on its own is a local event. The intermediate term
// agreeing is what makes it part of something larger.
itfArrayAgree(int dir) =>
    not mtfAnalysis or not htfIsHigher or (dir == 1 ? itfGapBull : itfGapBear)

// ── Gate 4: structure has actually shifted this way, and recently ────────────
// Any of the three resolutions counts — CISD is the scout, the swing event is
// the confirmation, the internal break is the continuation — but all of them
// have to be fresh. A CHoCH from forty bars ago is history, not a state.
structStateOK(int dir) =>
    dirStr = dir == 1 ? "Bullish" : "Bearish"
    cisdOK = not na(lastCISDBar) and bar_index - lastCISDBar <= structValidWindow and lastCISDDir == dirStr
    swingOK = not na(lastStructBar) and bar_index - lastStructBar <= structValidWindow and lastStructDir == dirStr
    intOK = not na(lastAnyStructBar) and bar_index - lastAnyStructBar <= structValidWindow and lastAnyStructDir == dirStr
    cisdOK or swingOK or intOK

// ── Gate 5: stops were run before the reversal ───────────────────────────────
// A purge in the trade's direction, a Turtle Soup raid, or the day's Judas
// swing. Reversals that take nothing on the way are the ones that fail.
liquidityTaken(int dir) =>
    dirStr = dir == 1 ? "Bullish" : "Bearish"
    purgeOK = purgedRecently(dir, liqTakenWindow)
    tsOK = lastTSDir == dirStr and not na(lastTSBar) and bar_index - lastTSBar <= liqTakenWindow
    jdOK = judasDir == dirStr and not na(judasBar) and bar_index - judasBar <= liqTakenWindow
    purgeOK or tsOK or jdOK

// ═══════════════════════════════════════════════════════════════════════════
// THE ENTRY: ARM, THEN CONFIRM
// ═══════════════════════════════════════════════════════════════════════════
// The entry is a sequence, not a candle.
//
// The old trigger demanded three things on one bar: the tap, a close in the
// trade's direction, and a close that had *not left the array*. That last
// condition is what silenced the engine — it rejects the displacement candle
// that reclaims the level, which is the actual ICT confirmation, and accepts
// only candles too weak to escape the zone they bounced in. Chasing is a risk
// problem, not a geometry one, so it is priced as one below.
//
// Arming records that price reached the level. Confirming records that price
// turned there. Between them the setup carries `armExtreme`, the furthest wick
// into the array, which is the invalidation the stop is measured from.

// The entry band of an array: from its far edge to its 50% mean threshold. A
// long is filled between the bottom of a demand zone and its consequent
// encroachment; a short between the mean and the top of a supply zone.
armBandLo(int dir, float bot, float mid) =>
    (dir == 1 ? bot : mid) - tapTol

armBandHi(int dir, float top, float mid) =>
    (dir == 1 ? mid : top) + tapTol

// Is an equivalent setup already armed? Two arrays whose bands sit within the
// tap tolerance of each other are one level being tested, not two.
alreadyArmed(int dir, float top, float bot) =>
    bool dup = false
    for a in armedSetups
        if a.dir == dir and math.abs(a.top - top) <= tapTol and math.abs(a.bottom - bot) <= tapTol
            dup := true
            break
    dup

// How many setups are armed in a direction, and the weakest tier among them —
// so the cap can be enforced without letting a bare gap crowd out an order
// block.
armedCount(int dir) =>
    int n = 0
    for a in armedSetups
        if a.dir == dir
            n += 1
    n

pushArmed(int dir, float top, float bot, int tier, string kind, bool fresh) =>
    if not alreadyArmed(dir, top, bot)
        // Four per side is enough for every array price can plausibly be
        // testing at once, and bounds the update pass.
        if armedCount(dir) >= 4
            // Drop the weakest same-direction setup to make room for a better
            // one; keep the incumbent if the newcomer is no better.
            int worstIdx = -1
            int worstTier = tier
            nA = array.size(armedSetups)
            if nA > 0
                for i = 0 to nA - 1
                    a = array.get(armedSetups, i)
                    if a.dir == dir and a.tier < worstTier
                        worstTier := a.tier
                        worstIdx := i
            if worstIdx >= 0
                array.remove(armedSetups, worstIdx)
        if armedCount(dir) < 4
            bumpArmStat(0)
            array.push(armedSetups, ArmedSetup.new(dir=dir, top=top, bottom=bot, mean=math.avg(top, bot), tier=tier, kind=kind, fresh=fresh, armBar=bar_index, armExtreme=dir == 1 ? low : high))

// Gaps are tier 3 when the intermediate term left one too and tier 2 when only
// this chart did. Taken as a parameter rather than picked with a ternary,
// because the side has to be chosen by the caller for the collection type to
// stay unambiguous.
scanGapsForArms(array<FVG> gaps, int dir, float probe, float reach) =>
    for f in gaps
        if bar_index <= f.candle3_idx
            continue
        // A gap is spent when its far edge has been *closed through* — at which
        // point it is an inversion facing the other way — not when price has
        // merely touched it. Retiring on the mitigation flag was fatal here: that
        // flag is raised at consequent encroachment, which is the very level the
        // entry needs price to reach, so the array was being destroyed by the
        // event that qualified it, and the classic wick-in-then-rebalance entry
        // could never be seen.
        if (dir == 1 ? close < f.bottom : close > f.top)
            continue
        mid = math.avg(f.top, f.bottom)
        if math.abs(mid - probe) > reach
            continue
        if probe <= armBandHi(dir, f.top, mid) and probe >= armBandLo(dir, f.bottom, mid)
            isHTF = f.timeframe != timeframe.period
            pushArmed(dir, f.top, f.bottom, isHTF ? 3 : 2, isHTF ? "HTF FVG" : "FVG", not f.mitigated)

// ── The arming scan ──────────────────────────────────────────────────────────
// Runs every bar in both directions. No gate is consulted here: arming is only
// the observation that price reached a level, and the gates decide whether the
// trade is worth taking at the moment it confirms — which is when it would
// actually be entered, and therefore the only moment their answers matter.
scanForArms(int dir) =>
    probe = dir == 1 ? low : high
    // Anything this bar's range never came near cannot have been tapped. The
    // check is two comparisons and it skips the band arithmetic for the great
    // majority of a few hundred arrays every bar.
    reach = 1.5 * volUnit
    for z in zones
        if not z.active or z.dir != dir or z.kind == "VI"
            continue
        // A zone may not be credited with a tap that predates its own
        // confirmation.
        if bar_index <= z.confirmBar
            continue
        if math.abs(z.mean - probe) > reach
            continue
        if probe <= armBandHi(dir, z.top, z.mean) and probe >= armBandLo(dir, z.bottom, z.mean)
            pushArmed(dir, z.top, z.bottom, zoneTier(z), z.kind, z.touches <= 1)
    if dir == 1
        scanGapsForArms(bullishFVGs, 1, probe, reach)
    else
        scanGapsForArms(bearishFVGs, -1, probe, reach)

// ── The update and confirmation pass ─────────────────────────────────────────
// Walked once per bar. Confirmed setups are moved into the two single-element
// buffers the main execution block reads; expiries and invalidations are
// counted so a quiet chart can say which of the two it is.
//
// The four confirmation triggers are the four ways price says it has turned at
// a level, and every one of them is already computed upstream. A reclaim of the
// mean is the minimum; the other three are the same statement made louder.
updateArmed(bool cisdUp, bool cisdDn, bool structUp, bool structDn, bool dispUp, bool dispDn) =>
    array.clear(confirmedLong)
    array.clear(confirmedShort)
    n = array.size(armedSetups)
    if n > 0
        for idx = 0 to n - 1
            i = n - 1 - idx
            if i < 0
                break
            a = array.get(armedSetups, i)
            isLong = a.dir == 1

            // The wick keeps extending while the setup waits, so the stop is
            // always measured from the deepest test the level has survived.
            a.armExtreme := isLong ? math.min(a.armExtreme, low) : math.max(a.armExtreme, high)

            // The array failed. This is the setup's real invalidation and it
            // retires the arm immediately, whatever the window has left.
            if (isLong ? close < a.bottom - tapTol : close > a.top + tapTol)
                bumpArmStat(3)
                array.remove(armedSetups, i)
                continue

            if bar_index - a.armBar > armWindow
                bumpArmStat(2)
                array.remove(armedSetups, i)
                continue

            // Arming and confirming on the same candle is allowed — a wick into
            // the level that closes back through its mean is one candle doing
            // both jobs, and it is a perfectly good entry.
            reclaim = isLong ? (close > open and close > a.mean) : (close < open and close < a.mean)
            trigger = reclaim or (isLong ? (cisdUp or structUp or dispUp) : (cisdDn or structDn or dispDn))
            if trigger
                // The only anti-chase test the engine needs. A confirmation may
                // close as far from the array as it likes provided the stop it
                // implies is still affordable — which is exactly what the old
                // geometric guard got wrong.
                if math.abs(close - a.armExtreme) <= maxStopATR * volUnit
                    bumpArmStat(1)
                    if isLong
                        if array.size(confirmedLong) == 0 or a.tier > array.get(confirmedLong, 0).tier
                            array.clear(confirmedLong)
                            array.push(confirmedLong, a)
                    else
                        if array.size(confirmedShort) == 0 or a.tier > array.get(confirmedShort, 0).tier
                            array.clear(confirmedShort)
                            array.push(confirmedShort, a)
                    array.remove(armedSetups, i)

// ── Stage B: the weighted stack ─────────────────────────────────────────────
sniperStack(int dir, int tier, bool fresh) =>
    dirStr = dir == 1 ? "Bullish" : "Bearish"
    // Recomputed from lastDispUpBar rather than read from dispUpRecent, because
    // that value is produced by the engine section further down the file and
    // Pine resolves identifiers in file order.
    dispUpFresh = lastDispUpBar >= 0 and bar_index - lastDispUpBar <= dispWindow
    dispDnFresh = lastDispDnBar >= 0 and bar_index - lastDispDnBar <= dispWindow
    inOTEBand = oteValid and oteDir == dir and close <= math.max(ote62, ote79) and close >= math.min(ote62, ote79)
    cisdOK = not na(lastCISDBar) and bar_index - lastCISDBar <= structValidWindow and lastCISDDir == dirStr
    swingFresh = not na(lastStructBar) and bar_index - lastStructBar <= structValidWindow and lastStructDir == dirStr
    mssOK = swingFresh and lastStructEvent == "MSS"
    room = na(dolPx) ? 0.0 : math.abs(dolPx - close) / math.max(volUnit, syminfo.mintick)
    // A tier-3 order block is a solid array, not 60% of one. The tier / 5 ramp
    // charged every realistic setup a third of the largest weight in the stack
    // for the crime of not being a Unicorn.
    tierPts = tier >= 5 ? 1.0 : tier == 4 ? 0.9 : tier == 3 ? 0.75 : tier == 2 ? 0.5 : 0.25

    // Numerator and denominator accumulate together so a factor that cannot apply
    // leaves the scale entirely rather than scoring zero against the setup.
    // Dividing by the sum of every weight assumed all ten could max out at once,
    // which nothing ever does — it is why observable scores topped out near fifty
    // and no threshold worth setting was reachable.
    float num = wPD * (na(drEq) ? 0.5 : (dir == 1 ? inDiscount : inPremium) ? 1.0 : 0.0)
    float den = wPD
    num += wArray * tierPts
    den += wArray
    num += wFresh * (fresh ? 1.0 : 0.5)
    den += wFresh
    // With the leg pointing the other way the OTE band is meaningless, not failed.
    if oteValid and oteDir == dir
        num += wOTE * (inOTEBand ? 1.0 : 0.4)
        den += wOTE
    // Displacement is strictly defined and genuinely rare; its absence should not
    // cost most of the weight.
    num += wDisp * ((dir == 1 ? dispUpFresh : dispDnFresh) ? 1.0 : 0.45)
    den += wDisp
    num += wSeq * ((cisdOK ? 0.5 : 0.0) + (mssOK ? 0.5 : swingFresh ? 0.3 : 0.0))
    den += wSeq
    num += wVol * scoreVolume()
    den += wVol
    // No correlated partner means nothing can diverge, so SMT leaves the scale.
    if smtAvailable
        num += wSMT * (smtDir == dirStr ? 1.0 : smtDir == "None" ? 0.75 : 0.0)
        den += wSMT
    // The off-killzone floor is 0.5, not 0.3. A killzone is a statement about
    // when the London and New York desks are active, and on an instrument that
    // trades around the clock — crypto especially — most of the day falls
    // outside all four windows. A permanent deduction for that is not a measure
    // of setup quality, it is a measure of the asset class.
    num += wTime * (inMacro ? 1.0 : inSilverBullet ? 0.9 : (inNYAMKZ or inLondonKZ) ? 0.75 : inAnyKZ ? 0.6 : 0.5)
    den += wTime
    num += wDOLRoom * (dolDir == dir ? math.min(1.0, room / math.max(dolMinRoomATR * 2.0, 0.5)) : 0.0)
    den += wDOLRoom
    num += wPO3 * scorePO3(dir)
    den += wPO3

    math.round(math.max(0.0, math.min(100.0, num / math.max(den, 1.0) * 100.0)), 0)


// ── Stage A: run the cascade, record every gate, then score what survives ────
// The gate array is passed in and written by index so the dashboard checklist
// walks the same structure the engine does and can never drift out of step with
// it.
sniperEvaluate(int dir, array<bool> g) =>
    dirStr = dir == 1 ? "Bullish" : "Bearish"
    g0 = not gateHTF or htfBias == dir
    g1 = not gateITF or itfArrayAgree(dir)
    g2 = not gatePD or (not na(drEq) and (dir == 1 ? inDiscount : inPremium))
    // A daily bar is stamped at its session open, which falls in none of the
    // killzone windows, so on a daily or higher chart this gate would reject
    // every bar forever. Killzones are an intraday concept; above that the gate
    // has nothing to say and stands down.
    g3 = not gateKZ or not timeframe.isintraday or inAnyKZ
    g4 = not gateStruct or structStateOK(dir)
    g5 = not gateLiq or liquidityTaken(dir)
    g6 = not gateSMT or not smtAvailable or smtDir == "None" or smtDir == dirStr
    g7 = not gateDOL or (dolDir == dir and not na(dolPx) and math.abs(dolPx - close) >= dolMinRoomATR * volUnit)
    cascadeOK = g0 and g1 and g2 and g3 and g4 and g5 and g6 and g7
    // How many gates said no. A gate that is disarmed passes unconditionally, so
    // this only ever counts gates the user actually armed — which is what makes
    // "failed exactly one gate" a meaningful grade rather than an artefact of
    // how many gates happen to be switched on.
    int failCount = (g0 ? 0 : 1) + (g1 ? 0 : 1) + (g2 ? 0 : 1) + (g3 ? 0 : 1) + (g4 ? 0 : 1) + (g5 ? 0 : 1) + (g6 ? 0 : 1) + (g7 ? 0 : 1)
    // Gate 8 is the entry itself, and it is no longer a scan: the state machine
    // has already done the work and either handed this direction a confirmed
    // setup or it has not.
    bool entered = false
    int aTier = 0
    bool aFresh = false
    if dir == 1
        if array.size(confirmedLong) > 0
            c = array.get(confirmedLong, 0)
            entered := true
            aTier := c.tier
            aFresh := c.fresh
    else
        if array.size(confirmedShort) > 0
            c = array.get(confirmedShort, 0)
            entered := true
            aTier := c.tier
            aFresh := c.fresh
    array.set(g, 0, g0)
    array.set(g, 1, g1)
    array.set(g, 2, g2)
    array.set(g, 3, g3)
    array.set(g, 4, g4)
    array.set(g, 5, g5)
    array.set(g, 6, g6)
    array.set(g, 7, g7)
    array.set(g, 8, entered)
    allPass = cascadeOK and entered
    // A B-grade candidate is scored on the identical stack. The grade reflects
    // the missing gate, never a different or softer measurement. Structure is
    // required either way — with no shift there is no reversal to trade, at any
    // grade.
    bCandidate = not cascadeOK and entered and enableBTier and failCount == 1 and g4
    score = (allPass or bCandidate) ? sniperStack(dir, aTier, aFresh) : 0.0
    [allPass, score, bCandidate]

// ── Which model has actually formed ─────────────────────────────────────────
// The engine names the setup rather than emitting a bare number, because "87"
// tells you nothing about what to do when it goes wrong. The ICT 2022 Model
// outranks everything else: it is the full sequence — liquidity taken, delivery
// changed with displacement, entry from the array left behind — and when a
// Unicorn or a Silver Bullet window is part of that sequence it belongs in the
// narrative rather than replacing the name.
sniperModelName(int dir, string kind, bool fresh) =>
    dirStr = dir == 1 ? "Bullish" : "Bearish"
    cisdOK = not na(lastCISDBar) and bar_index - lastCISDBar <= structValidWindow and lastCISDDir == dirStr
    swingFresh = not na(lastStructBar) and bar_index - lastStructBar <= structValidWindow and lastStructDir == dirStr
    mssOK = swingFresh and lastStructEvent == "MSS"
    dispFresh = dir == 1 ? (lastDispUpBar >= 0 and bar_index - lastDispUpBar <= dispWindow) : (lastDispDnBar >= 0 and bar_index - lastDispDnBar <= dispWindow)
    sweepOK = purgedRecently(dir, liqTakenWindow)
    tsOK = lastTSDir == dirStr and not na(lastTSBar) and bar_index - lastTSBar <= liqTakenWindow
    jdOK = judasDir == dirStr and not na(judasBar) and bar_index - judasBar <= liqTakenWindow
    bool qmOK = false
    for q in qmPatterns
        if q.active and q.dir == dir and bar_index - q.barIdx <= qmMaxAge
            qmOK := true
            break
    isGap = kind == "FVG" or kind == "HTF FVG"
    inOTEBand = oteValid and oteDir == dir and close <= math.max(ote62, ote79) and close >= math.min(ote62, ote79)

    string model = "PD Array Tap"
    if (sweepOK or tsOK or jdOK) and (cisdOK or mssOK) and dispFresh
        model := "ICT 2022 Model"
    else if inSilverBullet and isGap
        model := "Silver Bullet"
    else if jdOK
        model := "Judas Swing"
    else if tsOK
        model := "Turtle Soup"
    else if kind == "Unicorn"
        model := "Unicorn"
    else if qmOK
        model := "Quasimodo"
    else if cisdOK and not mssOK
        model := "CISD Scout"

    smtWord = not smtAvailable ? "n/a" : smtDir == dirStr ? "confirmed" : smtDir == "None" ? "aligned" : "opposed"
    narrative = kind + (fresh ? " fresh" : "") + (inOTEBand ? " + OTE" : "") + " in " + (dir == 1 ? "Discount" : "Premium") + " | " + getActiveWindow() + " | SMT " + smtWord + " | DOL: " + dolName
    [model, narrative]

// ── The stop comes from the setup's own invalidation ────────────────────────
// Never a blanket ATR multiple. Turtle Soup and Judas stop beyond the raided
// extreme, Quasimodo beyond the Head, everything with a purge behind it beyond
// the purge wick, and the array edge is both the fallback and the floor: the
// wider of the two is taken, because the trade is wrong if either is violated.
sniperStop(int dir, float armExtreme, float aBot, float aTop, string model) =>
    buf = math.max(slPaddingATR * volUnit, syminfo.mintick * 2)
    // The wick that actually tested the level, floored at the array's own far
    // edge. This is the entry's real invalidation: you are wrong when the level
    // that filled you fails, and the deepest point it survived is where that is
    // measured from.
    edge = dir == 1 ? math.min(nz(armExtreme, aBot), aBot) : math.max(nz(armExtreme, aTop), aTop)
    // Widening to a swing invalidation is only justified when that swing is the
    // reason for the trade. A blanket fallback to the most recent purge wick —
    // valid for sixty bars and up to the full risk budget away — was dragging
    // the stop out on setups that had nothing to do with the purge, and then the
    // reward:risk test refused the trade for the width the fallback had just
    // added. Purge models widen; a plain array tap stands on its own edge.
    float ref = na
    if model == "Turtle Soup" and not na(lastTSStop)
        ref := lastTSStop
    else if model == "Judas Swing" and not na(judasLevel)
        ref := judasLevel
    else if model == "Quasimodo"
        for q in qmPatterns
            if q.active and q.dir == dir
                ref := q.head
                break
    else if model == "ICT 2022 Model"
        ref := purgeStopRef(dir)
    float chosen = edge
    if not na(ref) and (dir == 1 ? ref < edge and ref < close : ref > edge and ref > close)
        if math.abs(close - ref) <= maxStopATR * volUnit
            chosen := ref
    dir == 1 ? chosen - buf : chosen + buf

// A tracked trade built from explicit prices rather than from an FVG, so the
// invalidation-based stop and the SD/DOL objectives survive intact. TP1 and TP2
// are always drawn here: on a sniper signal they are the objectives, not
// optional partials.
createSniperRisk(int entryBar, float entry, float sl, float tp1, float tp2, float tp3, bool isLong) =>
    slLine = line.new(entryBar, sl, bar_index, sl, color=slColor, width=2)
    tpLine = line.new(entryBar, tp3, bar_index, tp3, color=tpColor, width=2)
    p1 = line.new(entryBar, tp1, bar_index, tp1, color=partialTPColor, width=1, style=line.style_dashed)
    p2 = line.new(entryBar, tp2, bar_index, tp2, color=partialTPColor, width=1, style=line.style_dotted)
    // tp3 already has the solid target line above, so the third partial is a
    // placeholder the lifecycle can delete alongside the others.
    p3 = line.new(bar_index, 0, bar_index, 0, color=color.new(color.black, 100))
    RiskLevels.new(entryBarIdx=entryBar, entryPrice=entry, slPrice=sl, tpPrice=tp3, partialTP=tp1, partialTP2=tp2, partialTP3=tp3, signalType=isLong ? "BUY" : "SELL", lastBarDrawn=entryBar, active=true, slLine=slLine, tpLine=tpLine, partialLine=p1, partialLine2=p2, partialLine3=p3)

// Hard cap on tracked trades. Each one owns five lines, and the array is
// otherwise only trimmed by age or by being closed out, so a burst of signals
// could quietly consume the line budget the zones and structure share.
capRiskLevels() =>
    while array.size(riskLevels) > maxTrackedTrades
        r = array.shift(riskLevels)
        line.delete(r.slLine)
        line.delete(r.tpLine)
        line.delete(r.partialLine)
        line.delete(r.partialLine2)
        line.delete(r.partialLine3)

// ═══════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ═══════════════════════════════════════════════════════════════════════════
// Five lines. What is left is only what you act on: which way the engine is
// biased, whether the clock allows a trade at all, which half of the range price
// is in, where it is being delivered to, and what the signal engine is doing
// about it.

// When nothing fires, the one thing worth knowing is which gate said no.
firstBlockedGate(array<bool> g) =>
    not array.get(g, 0) ? "HTF Bias" : not array.get(g, 1) ? "ITF Array" : not array.get(g, 2) ? "PD Range" : not array.get(g, 3) ? "Killzone" : not array.get(g, 4) ? "Structure" : not array.get(g, 5) ? "Liquidity" : not array.get(g, 6) ? "SMT" : not array.get(g, 7) ? "DOL" : not array.get(g, 8) ? "No entry" : "—"

// ── Gate diagnostics ───────────────────────────────────────────────────────
// Short names for the counter row, in cascade index order.
gateShortName(int i) =>
    i == 0 ? "HTF" : i == 1 ? "ITF" : i == 2 ? "PD" : i == 3 ? "KZ" : i == 4 ? "Struct" : i == 5 ? "Liq" : i == 6 ? "SMT" : i == 7 ? "DOL" : "Entry"

// The entry is not a switchable gate — it is the trigger itself and is always
// required — so index 8 reports as permanently armed.
gateArmed(int i) =>
    i == 0 ? gateHTF : i == 1 ? gateITF : i == 2 ? gatePD : i == 3 ? gateKZ : i == 4 ? gateStruct : i == 5 ? gateLiq : i == 6 ? gateSMT : i == 7 ? gateDOL : true

// Every armed gate and what it has rejected, both directions summed, in cascade
// order. This is the row that makes a deadlock visible: a gate holding a five-
// figure count while the setup tally sits in the dozens is the thing to disarm,
// and no amount of threshold tuning will substitute for disarming it.
// Listing every armed gate rather than ranking the worst few is deliberate:
// there are at most nine, usually two or three, so the row stays short — and a
// gate that appears here at all is a gate that is armed, which makes one
// switched on by accident visible without a separate legend.
gateBlockReport() =>
    string outTxt = ""
    for i = 0 to 8
        if gateArmed(i)
            c = array.get(gateBlockL, i) + array.get(gateBlockS, i)
            outTxt := outTxt + (outTxt == "" ? "" : "  ·  ") + gateShortName(i) + " " + str.tostring(c)
    outTxt == "" ? "nothing blocked yet" : outTxt

updateStatusTable() =>
    if uiRedraw and showStatusTable
        headerBG = color.new(color.rgb(20, 20, 35), 0)
        labelBG = color.new(color.rgb(35, 35, 55), 5)
        accentGreen = color.new(color.rgb(0, 200, 120), 15)
        accentRed = color.new(color.rgb(220, 50, 50), 15)
        accentGold = color.new(color.rgb(255, 200, 40), 10)
        dimText = color.rgb(160, 160, 180)
        brightText = color.white

        var table dash = table.new(position.top_right, 2, showDiagnostics ? 8 : 5, bgcolor=headerBG, border_width=0, frame_width=1, frame_color=color.new(color.rgb(60, 60, 80), 0))

        // ── Bias: chart structure, and the higher timeframe standing behind it ──
        biasTxt = marketStructure + (htfBias == 1 ? "  ·  HTF ▲" : htfBias == -1 ? "  ·  HTF ▼" : "  ·  HTF —")
        biasBG = marketStructure == "Uptrend" ? accentGreen : marketStructure == "Downtrend" ? accentRed : color.new(color.gray, 30)
        table.cell(dash, 0, 0, syminfo.ticker, text_color=accentGold, bgcolor=headerBG, text_size=size.normal, text_halign=text.align_left)
        table.cell(dash, 1, 0, biasTxt, text_color=brightText, bgcolor=biasBG, text_size=size.normal, text_halign=text.align_center)

        // ── The clock ──
        kzBG = inMacro ? accentGold : inSilverBullet ? color.new(color.rgb(200, 200, 220), 15) : inAnyKZ ? color.new(color.orange, 20) : color.new(color.gray, 45)
        table.cell(dash, 0, 1, "Killzone", text_color=dimText, bgcolor=labelBG, text_size=size.small, text_halign=text.align_left)
        table.cell(dash, 1, 1, getActiveWindow(), text_color=inMacro ? color.black : brightText, bgcolor=kzBG, text_size=size.small, text_halign=text.align_center)

        // ── Which half of the dealing range: never buy premium, never sell discount ──
        pdTxt = na(drEq) ? "No range yet" : inPremium ? "PREMIUM — sell side" : "DISCOUNT — buy side"
        pdBG = na(drEq) ? color.new(color.gray, 50) : inPremium ? accentRed : accentGreen
        table.cell(dash, 0, 2, "Range", text_color=dimText, bgcolor=labelBG, text_size=size.small, text_halign=text.align_left)
        table.cell(dash, 1, 2, pdTxt, text_color=brightText, bgcolor=pdBG, text_size=size.small, text_halign=text.align_center)

        // ── Where price is being delivered to ──
        dolDist = na(dolPx) ? 0.0 : math.abs(dolPx - close) / math.max(volUnit, syminfo.mintick)
        dolTxt = na(dolPx) ? "No qualifying pool" : (dolDir == 1 ? "▲ " : "▼ ") + dolName + " " + str.tostring(dolPx, format.mintick) + "  ·  " + str.tostring(dolDist, "#.#") + " ATR"
        dolBG = na(dolPx) ? color.new(color.gray, 50) : dolDir == 1 ? color.new(dolUpColor, 20) : color.new(dolDnColor, 20)
        table.cell(dash, 0, 3, "Draw on Liq", text_color=dimText, bgcolor=labelBG, text_size=size.small, text_halign=text.align_left)
        table.cell(dash, 1, 3, dolTxt, text_color=na(dolPx) ? brightText : color.black, bgcolor=dolBG, text_size=size.small, text_halign=text.align_center)

        // ── The engine's verdict, in priority order: fired now, on watch, or
        // the gate that is holding it up — with the age of the last real signal
        // so a quiet chart still tells you when it last spoke.
        firedNow = not na(lastSniperBar) and lastSniperBar == bar_index
        lastTag = na(lastSniperBar) ? "" : "  ·  last " + (sniperDir == 1 ? "▲" : "▼") + str.tostring(bar_index - lastSniperBar) + "b"
        // How often this has ever worked, so a quiet chart can be told apart
        // from a broken one without a second panel.
        // The ceiling actually reached, next to the bar it has to clear: with
        // these two numbers side by side the threshold sets itself.
        tally = "  ·  " + str.tostring(signalCount) + " fired / " + str.tostring(cascadePassBars) + " setups · best " + str.tostring(bestScoreSeen, "#") + " vs " + str.tostring(aPlusThreshold, "#")
        string sigTxt = ""
        color sigBG = color.new(color.gray, 50)
        color sigFG = brightText
        if not enableSniper
            sigTxt := "Sniper engine off"
        else if firedNow
            sigTxt := (sniperDir == 1 ? "▲ BUY  " : "▼ SELL  ") + sniperModel + "  " + str.tostring(sniperScore, "#") + "  ·  " + str.tostring(sniperRR, "#.#") + "R"
            sigBG := sniperDir == 1 ? accentGreen : accentRed
        else if watchModelL != ""
            sigTxt := "▲ watch " + watchModelL + "  " + str.tostring(watchScoreL, "#") + "/" + str.tostring(aPlusThreshold, "#") + tally
            sigBG := accentGold
            sigFG := color.black
        else if watchModelS != ""
            sigTxt := "▼ watch " + watchModelS + "  " + str.tostring(watchScoreS, "#") + "/" + str.tostring(aPlusThreshold, "#") + tally
            sigBG := accentGold
            sigFG := color.black
        else
            bL = firstBlockedGate(gateL)
            bS = firstBlockedGate(gateS)
            sigTxt := "blocked: " + (bL == bS ? bL : "▲" + bL + "  ▼" + bS) + lastTag + tally
        table.cell(dash, 0, 4, "Signal", text_color=dimText, bgcolor=labelBG, text_size=size.small, text_halign=text.align_left)
        table.cell(dash, 1, 4, sigTxt, text_color=sigFG, bgcolor=sigBG, text_size=size.small, text_halign=text.align_center)

        // ── Diagnostics ──
        // Naming the gate that blocked this one candle explains a candle. These
        // three rows explain the chart: what has been rejecting bars all along,
        // what became of every level price actually reached, and what happened to
        // the setups that cleared everything and still did not fire. Read them in
        // that order before touching any threshold.
        if showDiagnostics
            table.cell(dash, 0, 5, "Gates", text_color=dimText, bgcolor=labelBG, text_size=size.tiny, text_halign=text.align_left)
            table.cell(dash, 1, 5, gateBlockReport(), text_color=dimText, bgcolor=headerBG, text_size=size.tiny, text_halign=text.align_center)
            // Where setups went once price actually reached a level. "expired"
            // is price sitting at the array and never turning; "voided" is the
            // array failing outright. Neither is the engine refusing a trade,
            // and telling them apart is what separates a quiet market from a
            // broken filter.
            armTxt = "armed " + str.tostring(array.get(armStats, 0)) + " → conf " + str.tostring(array.get(armStats, 1)) + " · exp " + str.tostring(array.get(armStats, 2)) + " · void " + str.tostring(array.get(armStats, 3))
            table.cell(dash, 0, 6, "Entries", text_color=dimText, bgcolor=labelBG, text_size=size.tiny, text_halign=text.align_left)
            table.cell(dash, 1, 6, armTxt, text_color=dimText, bgcolor=headerBG, text_size=size.tiny, text_halign=text.align_center)
            rejTxt = "score " + str.tostring(rejScore) + " · RR " + str.tostring(rejRR) + " · cool " + str.tostring(rejCooldown) + " · stop " + str.tostring(rejStop) + (enableBTier ? "  |  B " + str.tostring(bTierCount) : "")
            table.cell(dash, 0, 7, "Rejects", text_color=dimText, bgcolor=labelBG, text_size=size.tiny, text_halign=text.align_left)
            table.cell(dash, 1, 7, rejTxt, text_color=dimText, bgcolor=headerBG, text_size=size.tiny, text_halign=text.align_center)

// ═══════════════════════════════════════════════════════════════════════════
// DELIVERY RUN TRACKER
// ═══════════════════════════════════════════════════════════════════════════
// A delivery run is a series of consecutive same-direction closes — one leg of
// algorithmic delivery. The opening price of the run's first candle is the level
// that, once closed through, marks a change in the state of delivery.
runIsUp = close > open
runIsDn = close < open

if canDetect
    if runIsUp and runDir != 1
        upRunStart := bar_index
        upRunOpen := open
        upRunHigh := high
        upRunLen := 1
        upRunBroken := false
        runDir := 1
    else if runIsDn and runDir != -1
        dnRunStart := bar_index
        dnRunOpen := open
        dnRunLow := low
        dnRunLen := 1
        dnRunBroken := false
        runDir := -1
    else if runDir == 1
        upRunHigh := math.max(nz(upRunHigh, high), high)
        upRunLen += runIsUp ? 1 : 0
    else if runDir == -1
        dnRunLow := math.min(nz(dnRunLow, low), low)
        dnRunLen += runIsDn ? 1 : 0

// ═══════════════════════════════════════════════════════════════════════════
// MARKET STRUCTURE — BOS / CHoCH / MSS
// ═══════════════════════════════════════════════════════════════════════════
// Pivots come from ta.pivothigh / ta.pivotlow, which confirm only after `len`
// bars have closed on both sides — inherently non-repainting.
//   BOS   — close beyond the prior swing extreme in the direction of the trend
//   CHoCH — first close beyond the opposing extreme, flipping the trend
//   MSS   — a CHoCH backed by displacement, the high-quality reversal trigger

// ── Displacement: an energetic candle that leaves an imbalance behind it ──
dispBodyUp = close[1] - open[1]
dispBodyDn = open[1] - close[1]
displacementUp = dispBodyUp >= dispATRMult * volUnit and low > high[2]
displacementDn = dispBodyDn >= dispATRMult * volUnit and high < low[2]

if canDetect and displacementUp
    lastDispUpBar := bar_index
if canDetect and displacementDn
    lastDispDnBar := bar_index

dispUpRecent = lastDispUpBar >= 0 and bar_index - lastDispUpBar <= dispWindow
dispDnRecent = lastDispDnBar >= 0 and bar_index - lastDispDnBar <= dispWindow

// ── Confirmed pivots at two resolutions ──
swingPH = ta.pivothigh(high, swingLen, swingLen)
swingPL = ta.pivotlow(low, swingLen, swingLen)
internalPH = ta.pivothigh(high, internalLen, internalLen)
internalPL = ta.pivotlow(low, internalLen, internalLen)

// Extremes of the CISD qualification window. Hoisted here, unconditional, so the
// series stays consistent on every bar.
cisdLowestWin = ta.lowest(low, cisdExtremeLookback)
cisdHighestWin = ta.highest(high, cisdExtremeLookback)

// ── Alternating zig-zag with same-type dedupe ──
// Two consecutive highs with no low between them are one swing, so the less
// extreme of the pair is folded away. Quasimodo pattern matching reads three
// adjacent pivots and depends on that strict alternation holding.
pushPivot(int idx, float price, bool isHigh) =>
    n = array.size(swingPoints)
    if n > 0
        last = array.get(swingPoints, n - 1)
        if last.isHigh == isHigh
            if (isHigh and price > last.price) or (not isHigh and price < last.price)
                last.index := idx
                last.price := price
        else
            array.push(swingPoints, SwingPoint.new(index=idx, price=price, isHigh=isHigh))
    else
        array.push(swingPoints, SwingPoint.new(index=idx, price=price, isHigh=isHigh))
    // Quasimodo matches over the last three pivots and nothing else reads this
    // list, so a handful of headroom above that is the whole requirement.
    while array.size(swingPoints) > 8
        array.shift(swingPoints)

// ── Register new swing pivots ──
// Every confirmed pivot is also resting liquidity, so it enters the purge
// registry at the same time. A pivot cannot already be breached at this point:
// ta.pivothigh only confirms once `swingLen` bars have closed below it.
if canDetect and not na(swingPH)
    swingHighPrice := swingPH
    swingHighBar := bar_index - swingLen
    swingHighTaken := false
    pushPivot(bar_index - swingLen, swingPH, true)
    registerLiqLevel(bar_index - swingLen, swingPH, true, true)
    // A pivot that was made by a wick rather than a body is a rejection block.
    tryRejectionBlock(swingLen, true)
    if showMarketStructure
        pivLbl = label.new(bar_index - swingLen, swingPH, "H", style=label.style_label_down, color=color.new(downTrendColorInput, 55), textcolor=color.white, size=size.tiny)
        array.push(pivotLabelRefs, pivLbl)
        capLabels(pivotLabelRefs, maxStructDrawings)

if canDetect and not na(swingPL)
    swingLowPrice := swingPL
    swingLowBar := bar_index - swingLen
    swingLowTaken := false
    pushPivot(bar_index - swingLen, swingPL, false)
    registerLiqLevel(bar_index - swingLen, swingPL, false, true)
    tryRejectionBlock(swingLen, false)
    if showMarketStructure
        pivLbl = label.new(bar_index - swingLen, swingPL, "L", style=label.style_label_up, color=color.new(upTrendColorInput, 55), textcolor=color.white, size=size.tiny)
        array.push(pivotLabelRefs, pivLbl)
        capLabels(pivotLabelRefs, maxStructDrawings)

// ── Register new internal pivots ──
if canDetect and not na(internalPH)
    intHighPrice := internalPH
    intHighBar := bar_index - internalLen
    intHighTaken := false
    if sweepTrackInternal
        registerLiqLevel(bar_index - internalLen, internalPH, true, false)
    tryRejectionBlock(internalLen, true)
if canDetect and not na(internalPL)
    intLowPrice := internalPL
    intLowBar := bar_index - internalLen
    intLowTaken := false
    if sweepTrackInternal
        registerLiqLevel(bar_index - internalLen, internalPL, false, false)
    tryRejectionBlock(internalLen, false)

// ── Draw a structure break (line back to the broken pivot + tag) ──
drawStructureBreak(int fromBar, float price, string txt, color col, bool isUp) =>
    ln = line.new(fromBar, price, bar_index, price, color=col, width=2, style=line.style_dashed)
    lb = label.new(int(math.avg(fromBar, bar_index)), price, txt, style=isUp ? label.style_label_down : label.style_label_up, color=color.new(col, 20), textcolor=color.white, size=size.tiny)
    array.push(structLineRefs, ln)
    array.push(structLabelRefs, lb)
    capLines(structLineRefs, maxStructDrawings)
    capLabels(structLabelRefs, maxStructDrawings)

// ── Swing structure breaks ──
bullBreakSwing = canDetect and not na(swingHighPrice) and not swingHighTaken and close > swingHighPrice
bearBreakSwing = canDetect and not na(swingLowPrice) and not swingLowTaken and close < swingLowPrice

if bullBreakSwing
    isReversal = swingTrend == -1
    evtName = isReversal ? (dispUpRecent ? "MSS" : "CHoCH") : "BOS"
    evtColor = evtName == "MSS" ? mssColor : evtName == "CHoCH" ? chochColor : bosColor
    swingHighTaken := true
    swingTrend := 1
    lastStructEvent := evtName
    lastStructBar := bar_index
    lastStructDir := "Bullish"
    lastAnyStructBar := bar_index
    lastAnyStructDir := "Bullish"
    if showSwingStructure
        drawStructureBreak(swingHighBar, swingHighPrice, evtName + " ▲", evtColor, true)

if bearBreakSwing
    isReversal = swingTrend == 1
    evtName = isReversal ? (dispDnRecent ? "MSS" : "CHoCH") : "BOS"
    evtColor = evtName == "MSS" ? mssColor : evtName == "CHoCH" ? chochColor : bosColor
    swingLowTaken := true
    swingTrend := -1
    lastStructEvent := evtName
    lastStructBar := bar_index
    lastStructDir := "Bearish"
    lastAnyStructBar := bar_index
    lastAnyStructDir := "Bearish"
    if showSwingStructure
        drawStructureBreak(swingLowBar, swingLowPrice, evtName + " ▼", evtColor, false)

// ── Internal structure breaks (faster, used for entry timing) ──
// Hoisted into named values, and the event name resolved before intTrend is
// mutated, so the zone engine downstream can read both.
intBullBreak = canDetect and not na(intHighPrice) and not intHighTaken and close > intHighPrice
intBearBreak = canDetect and not na(intLowPrice) and not intLowTaken and close < intLowPrice
intBullEvt = intTrend == -1 ? "i-CHoCH" : "i-BOS"
intBearEvt = intTrend == 1 ? "i-CHoCH" : "i-BOS"

if intBullBreak
    intHighTaken := true
    intTrend := 1
    lastAnyStructBar := bar_index
    lastAnyStructDir := "Bullish"
    if showInternalStructure
        drawStructureBreak(intHighBar, intHighPrice, intBullEvt, color.new(bosColor, 40), true)

if intBearBreak
    intLowTaken := true
    intTrend := -1
    lastAnyStructBar := bar_index
    lastAnyStructDir := "Bearish"
    if showInternalStructure
        drawStructureBreak(intLowBar, intLowPrice, intBearEvt, color.new(bosColor, 40), false)

// Primary trend, consumed by the confluence scoring and the trend filter
marketStructure := swingTrend == 1 ? "Uptrend" : swingTrend == -1 ? "Downtrend" : "Neutral"

// ═══════════════════════════════════════════════════════════════════════════
// LIQUIDITY PURGE PASS
// ═══════════════════════════════════════════════════════════════════════════
// Runs after pivot registration so a level confirmed on this bar is in the
// registry, and before CISD so a purge into the extreme is already known.
if canDetect
    updateLiquidityLevels()
    cleanPurges()
    // One pass over the registry answers every purge question asked this bar.
    livePurgeUpBar := na
    livePurgeUpWick := na
    livePurgeDnBar := na
    livePurgeDnWick := na
    for s in liqSweeps
        if not s.invalidated
            if s.dir == 1
                if na(livePurgeUpBar) or s.confirmBar > livePurgeUpBar
                    livePurgeUpBar := s.confirmBar
                    livePurgeUpWick := s.wickExtreme
            else
                if na(livePurgeDnBar) or s.confirmBar > livePurgeDnBar
                    livePurgeDnBar := s.confirmBar
                    livePurgeDnWick := s.wickExtreme

// A purge confirmed on this very bar. lastPurgeExtreme carries the wick that
// made it, which is the invalidation point every reversal model stops behind.
purgeUpNow = purgedRecently(1, 0)
purgeDnNow = purgedRecently(-1, 0)
if purgeUpNow
    lastPurgeDir := "Sellside"
    lastPurgeBar := bar_index
    lastPurgeExtreme := nz(purgeStopRef(1), lastPurgeExtreme)
if purgeDnNow
    lastPurgeDir := "Buyside"
    lastPurgeBar := bar_index
    lastPurgeExtreme := nz(purgeStopRef(-1), lastPurgeExtreme)

// ═══════════════════════════════════════════════════════════════════════════
// CISD — CHANGE IN STATE OF DELIVERY
// ═══════════════════════════════════════════════════════════════════════════
// Bullish CISD is a body close above the opening of the down-close run that made
// the low; bearish is the mirror. On one reversal the three events fire in
// sequence — CISD, then CHoCH, then MSS — which gives the engine a scout trigger
// and a confirmation trigger from a single pass, with the scout carrying a far
// tighter stop because the run's extreme is only a few candles away.
cisdBodyNow = math.abs(close - open)
cisdDisplaced = cisdBodyNow >= dispATRMult * volUnit
// The run has to own the extreme of its window, otherwise every pullback inside
// a trend would register as a change in delivery. A small ATR slack lets the
// breaking candle's own wick undercut the run's extreme without voiding it.
cisdExtTol = 0.10 * volUnit
cisdPurgeUp = purgedRecently(1, cisdExtremeLookback)
cisdPurgeDn = purgedRecently(-1, cisdExtremeLookback)

// The effective extreme includes the reversing candle's own wick. Without it a
// breaking candle that undercut the run low before closing back up — the single
// most common reversal shape there is — would fail the window test.
cisdLowRef = math.min(nz(dnRunLow, low), low)
cisdHighRef = math.max(nz(upRunHigh, high), high)

bullCISD = canDetect and runIsUp and not na(dnRunOpen) and not dnRunBroken and dnRunLen >= cisdMinRun and close > dnRunOpen and cisdLowRef <= cisdLowestWin + cisdExtTol and (not cisdRequirePurge or cisdPurgeUp)
bearCISD = canDetect and runIsDn and not na(upRunOpen) and not upRunBroken and upRunLen >= cisdMinRun and close < upRunOpen and cisdHighRef >= cisdHighestWin - cisdExtTol and (not cisdRequirePurge or cisdPurgeDn)

if bullCISD
    dnRunBroken := true
    array.push(cisdEvents, CISDEvent.new(barIdx=bar_index, runStart=dnRunStart, level=dnRunOpen, extreme=cisdLowRef, dir=1, displaced=cisdDisplaced, purged=cisdPurgeUp))
    lastCISDDir := "Bullish"
    lastCISDBar := bar_index
    lastCISDLevel := dnRunOpen

if bearCISD
    upRunBroken := true
    array.push(cisdEvents, CISDEvent.new(barIdx=bar_index, runStart=upRunStart, level=upRunOpen, extreme=cisdHighRef, dir=-1, displaced=cisdDisplaced, purged=cisdPurgeDn))
    lastCISDDir := "Bearish"
    lastCISDBar := bar_index
    lastCISDLevel := upRunOpen

while array.size(cisdEvents) > 30
    array.shift(cisdEvents)

// ═══════════════════════════════════════════════════════════════════════════
// ZONE PASS — lifecycle first, then creation off this bar's structure break
// ═══════════════════════════════════════════════════════════════════════════
if canDetect
    updateZones()

// The impulse leg that broke structure is the current delivery run, so the
// origin candle — the last opposite-colour candle before the leg — sits
// immediately before the run started. Both lookups run unconditionally to keep
// their internal series consistent; the results are only consumed on break bars.
zoneOriginUp = findZoneOrigin(runDir == 1 ? upRunStart : bar_index, true)
zoneOriginDn = findZoneOrigin(runDir == -1 ? dnRunStart : bar_index, false)

if bullBreakSwing and zoneOriginUp > 0
    createZone(zoneOriginUp, 1, lastStructEvent)
else if zoneOnInternalBreaks and intBullBreak and zoneOriginUp > 0
    createZone(zoneOriginUp, 1, intBullEvt)

if bearBreakSwing and zoneOriginDn > 0
    createZone(zoneOriginDn, -1, lastStructEvent)
else if zoneOnInternalBreaks and intBearBreak and zoneOriginDn > 0
    createZone(zoneOriginDn, -1, intBearEvt)

// ═══════════════════════════════════════════════════════════════════════════
// VOLUME IMBALANCES AND OPENING GAPS
// ═══════════════════════════════════════════════════════════════════════════
// A volume imbalance is a gap between two candle *bodies* whose ranges still
// overlap: price crossed the area on a wick but never opened or closed inside
// it. It is the smallest array in the methodology, which is why it is off by
// default — price returns to them constantly and they would bury the chart.
viGapUp = open - close[1]
viGapDn = close[1] - open
viMin = viMinATR * volUnit
if canDetect and showVI and bar_index > 1
    if viGapUp >= viMin and low <= high[1]
        addZone(open, close[1], "VI", 1, bar_index - 1, "body gap ▲")
    else if viGapDn >= viMin and high >= low[1]
        addZone(close[1], open, "VI", -1, bar_index - 1, "body gap ▼")

// NDOG / NWOG — the gap between the prior session's close and the new session's
// open. timeframe.change() fires on the exchange's own session boundary, which
// on FX and futures is the 17:00 New York roll the NDOG is defined against, so
// there is no hand-rolled UTC hour here and the feed handles DST.
newDayBar = timeframe.change("D")
newWeekBar = timeframe.change("W")
ogMin = math.max(ogMinATR * volUnit, syminfo.mintick)
ogGapUp = open - close[1]
ogGapDn = close[1] - open
if canDetect and showOG and timeframe.isintraday and bar_index > 1
    ogKind = newWeekBar ? "NWOG" : "NDOG"
    if newWeekBar or newDayBar
        if ogGapUp >= ogMin
            addZone(open, close[1], ogKind, 1, bar_index - 1, ogKind)
        else if ogGapDn >= ogMin
            addZone(close[1], open, ogKind, -1, bar_index - 1, ogKind)

// ═══════════════════════════════════════════════════════════════════════════
// QUASIMODO — pattern-matched over the last three confirmed pivots
// ═══════════════════════════════════════════════════════════════════════════
// Bearish: Left Shoulder high -> Leg low -> Head high sweeping beyond the
// shoulder -> close through the Leg. The entry is the retrace back to the
// shoulder (the QML), the stop sits beyond the Head, the first objective is the
// broken Leg.
qmCount = array.size(swingPoints)
if canDetect and qmCount >= 3
    qmLS = array.get(swingPoints, qmCount - 3)
    qmLeg = array.get(swingPoints, qmCount - 2)
    qmHead = array.get(swingPoints, qmCount - 1)
    qmSweepMin = qmMinSweepATR * volUnit
    logged = false
    for q in qmPatterns
        if q.headBar == qmHead.index
            logged := true
            break
    // Tag the pattern on the bar the Leg actually breaks, or on the bar the Head
    // pivot confirms if the break already happened during its confirmation lag.
    // Without this the pattern could be announced dozens of bars after the QML
    // entry had come and gone.
    headJustConfirmed = qmHead.index == bar_index - swingLen
    if not logged
        if qmLS.isHigh and not qmLeg.isHigh and qmHead.isHigh and qmHead.price > qmLS.price + qmSweepMin and close < qmLeg.price and (close[1] >= qmLeg.price or headJustConfirmed)
            array.push(qmPatterns, QMPattern.new(barIdx=bar_index, dir=-1, qml=qmLS.price, head=qmHead.price, leg=qmLeg.price, lsBar=qmLS.index, headBar=qmHead.index, legBar=qmLeg.index, active=true))
            lastQMDir := "Bearish"
            lastQMBar := bar_index
        else if not qmLS.isHigh and qmLeg.isHigh and not qmHead.isHigh and qmHead.price < qmLS.price - qmSweepMin and close > qmLeg.price and (close[1] <= qmLeg.price or headJustConfirmed)
            array.push(qmPatterns, QMPattern.new(barIdx=bar_index, dir=1, qml=qmLS.price, head=qmHead.price, leg=qmLeg.price, lsBar=qmLS.index, headBar=qmHead.index, legBar=qmLeg.index, active=true))
            lastQMDir := "Bullish"
            lastQMBar := bar_index

if canDetect
    cleanQM()

// ═══════════════════════════════════════════════════════════════════════════
// DEALING RANGE — PREMIUM / DISCOUNT / EQUILIBRIUM
// ═══════════════════════════════════════════════════════════════════════════
// The range runs from the most recent confirmed swing low to the most recent
// confirmed swing high, expanding with price while it trades beyond either edge.
// Equilibrium is the 50% mark: ICT only buys in discount and sells in premium.
if canDetect and not na(swingPH)
    drHigh := swingPH
if canDetect and not na(swingPL)
    drLow := swingPL
// Expand with price while it trades beyond an edge, gated so the range cannot
// shift on the forming bar and then snap back.
if canDetect and not na(drHigh) and high > drHigh
    drHigh := high
if canDetect and not na(drLow) and low < drLow
    drLow := low

drEq := na(drHigh) or na(drLow) ? na : math.avg(drHigh, drLow)
inPremium := not na(drEq) and close > drEq
inDiscount := not na(drEq) and close < drEq

// ═══════════════════════════════════════════════════════════════════════════
// OTE AND STANDARD DEVIATION PROJECTIONS
// ═══════════════════════════════════════════════════════════════════════════
// The impulse leg runs from the older of the two live swing anchors to the
// newer, and it is measured off the dealing range's own edges so the extreme
// keeps extending while price is still delivering into it. Retracements at 0.62
// / 0.705 / 0.79 back from the extreme are the Optimal Trade Entry band.
legIsUp = nz(swingHighBar, -1) >= nz(swingLowBar, -1)
oteValid := not na(drHigh) and not na(drLow) and (drHigh - drLow) >= oteMinLegATR * volUnit
oteDir := legIsUp ? 1 : -1
oteAnchor := legIsUp ? drLow : drHigh
oteExtreme := legIsUp ? drHigh : drLow
legRange = oteExtreme - oteAnchor
ote62 := oteValid ? oteExtreme - legRange * 0.620 : na
ote705 := oteValid ? oteExtreme - legRange * 0.705 : na
ote79 := oteValid ? oteExtreme - legRange * 0.790 : na
sd05 := oteValid ? oteExtreme + legRange * 0.5 : na
sd10 := oteValid ? oteExtreme + legRange * 1.0 : na
sd20 := oteValid ? oteExtreme + legRange * 2.0 : na

if uiRedraw
    clearBoxes(drBoxRefs)
    clearLines(drLineRefs)
    clearLabels(drLabelRefs)
    if showDealingRange and not na(drEq)
        drLeft = int(math.max(0, math.min(nz(swingHighBar, bar_index - 50), nz(swingLowBar, bar_index - 50))))
        if showPDZones
            array.push(drBoxRefs, box.new(drLeft, drHigh, bar_index, drEq, bgcolor=premiumZoneColor, border_color=color.new(premiumZoneColor, 60), border_width=1))
            array.push(drBoxRefs, box.new(drLeft, drEq, bar_index, drLow, bgcolor=discountZoneColor, border_color=color.new(discountZoneColor, 60), border_width=1))
        array.push(drLineRefs, line.new(drLeft, drEq, bar_index, drEq, color=equilibriumColor, width=1, style=line.style_dotted))
        array.push(drLineRefs, line.new(drLeft, drHigh, bar_index, drHigh, color=color.new(premiumZoneColor, 30), width=1))
        array.push(drLineRefs, line.new(drLeft, drLow, bar_index, drLow, color=color.new(discountZoneColor, 30), width=1))
        array.push(drLabelRefs, label.new(bar_index, drEq, "EQ " + str.tostring(drEq, format.mintick), style=label.style_label_left, color=color.new(equilibriumColor, 25), textcolor=color.black, size=size.tiny))

// ═══════════════════════════════════════════════════════════════════════════
// TURTLE SOUP, JUDAS, POWER OF 3, SMT, DRAW ON LIQUIDITY
// ═══════════════════════════════════════════════════════════════════════════
// Runs last in the engine: every one of these reads something produced above it
// — the purge registry, the CISD and structure events, the dealing range that
// decides premium from discount, and the killzone map from the top of the file.

// The true day rolls at New York midnight, so the day's narrative state rolls
// with it rather than with the exchange session.
if newNYDay
    judasDone := false
    judasDir := "None"
    judasBar := na
    judasLevel := na
    po3Phase := "Accumulation"
    po3Dir := 0
    po3ManipLevel := na

// ── Turtle Soup ──────────────────────────────────────────────────────────────
// Price runs the extreme of the lookback window, closes back inside on the same
// bar, and the reversal is then confirmed by CISD or by a structure shift within
// the confirm window.
tsHighWin = ta.highest(high, tsLookback)[1]
tsLowWin = ta.lowest(low, tsLookback)[1]

if canDetect and showTurtleSoup
    // Stage 1 — the raid.
    if not na(tsHighWin) and high > tsHighWin and close < tsHighWin
        tsPendDir := -1
        tsPendBar := bar_index
        tsPendExtreme := high
        tsPendLevel := tsHighWin
    else if not na(tsLowWin) and low < tsLowWin and close > tsLowWin
        tsPendDir := 1
        tsPendBar := bar_index
        tsPendExtreme := low
        tsPendLevel := tsLowWin
    // Stage 2 — confirmation, expiry, or invalidation. Evaluated on the raid bar
    // too, because CISD frequently fires on the very candle that closes back
    // inside the level.
    if tsPendDir != 0
        if bar_index - tsPendBar > tsConfirmBars
            tsPendDir := 0
        else
            tsConfirmed = tsPendDir == 1 ? (bullCISD or bullBreakSwing or intBullBreak) : (bearCISD or bearBreakSwing or intBearBreak)
            // Closing beyond the raided extreme means the level was genuinely
            // broken rather than swept, and there is no soup.
            tsVoided = tsPendDir == 1 ? close < tsPendExtreme : close > tsPendExtreme
            if tsVoided
                tsPendDir := 0
            else if tsConfirmed
                lastTSDir := tsPendDir == 1 ? "Bullish" : "Bearish"
                lastTSBar := bar_index
                lastTSStop := tsPendExtreme
                if showTurtleSoup
                    eventLabel(bar_index, tsPendDir == 1 ? low : high, "Turtle Soup " + (tsPendDir == 1 ? "▲" : "▼") + " " + str.tostring(tsPendLevel, format.mintick), tsColor, tsPendDir == 1)
                tsPendDir := 0

// ── Judas Swing ──────────────────────────────────────────────────────────────
// The first sweep of the Asian range inside a killzone, reversed on the same
// bar. It is the move engineered to position traders the wrong way before the
// real expansion, so it is taken once per day and only the first one counts.
if canDetect and showJudas and not judasDone and (inLondonKZ or inNYAMKZ) and not na(asiaHigh) and not na(asiaLow)
    if high > asiaHigh and close < asiaHigh
        judasDir := "Bearish"
        judasBar := bar_index
        judasLevel := high
        judasDone := true
        eventLabel(bar_index, high, "Judas ▼", judasColor, false)
    else if low < asiaLow and close > asiaLow
        judasDir := "Bullish"
        judasBar := bar_index
        judasLevel := low
        judasDone := true
        eventLabel(bar_index, low, "Judas ▲", judasColor, true)

// ── Power of 3 (Accumulation / Manipulation / Distribution) ──────────────────
// The day's story in three acts, anchored on the True Day Open rather than the
// exchange session: price accumulates in a range, is manipulated through one
// side of it to harvest the stops resting there, then distributes in the other
// direction. The phase is what tells you whether a setup is early, on time, or
// late — a distribution-phase entry is chasing, an accumulation-phase entry is
// guessing, and the manipulation leg is where the engine wants to be filled.
if canDetect and showPO3
    if po3Phase == "Accumulation"
        if judasDir != "None" and judasBar == bar_index
            po3Phase := "Manipulation"
            po3Dir := judasDir == "Bearish" ? -1 : 1
            po3ManipLevel := judasLevel
        else if inAnyKZ and purgeUpNow
            po3Phase := "Manipulation"
            po3Dir := 1
            po3ManipLevel := nz(lastPurgeExtreme, low)
        else if inAnyKZ and purgeDnNow
            po3Phase := "Manipulation"
            po3Dir := -1
            po3ManipLevel := nz(lastPurgeExtreme, high)
    else if po3Phase == "Manipulation"
        // Distribution starts once delivery in the manipulated direction is
        // confirmed *and* price has carried the True Day Open with it. Either
        // one alone is a retracement.
        po3Deliv = po3Dir == 1 ? (bullCISD or bullBreakSwing or intBullBreak) : (bearCISD or bearBreakSwing or intBearBreak)
        po3PastOpen = na(trueDayOpen) or (po3Dir == 1 ? close > trueDayOpen : close < trueDayOpen)
        if po3Deliv and po3PastOpen
            po3Phase := "Distribution"

// ── SMT Divergence ───────────────────────────────────────────────────────────
// Correlated instruments deliver the same story. When one makes a higher high
// and its partner fails to, the move is not supported and the high is a raid on
// liquidity rather than an expansion.
smtPH = ta.pivothigh(high, smtLen, smtLen)
smtPL = ta.pivotlow(low, smtLen, smtLen)

if canDetect and smtAvailable and not na(smtPH)
    ourPHOld := ourPHNew
    cmpPHOld := cmpPHNew
    ourPHNew := smtPH
    cmpPHNew := smtHAdj[smtLen]
    if not na(ourPHOld) and not na(cmpPHOld) and not na(cmpPHNew)
        ourHH = ourPHNew > ourPHOld
        cmpHH = cmpPHNew > cmpPHOld
        if ourHH != cmpHH
            smtDir := "Bearish"
            smtBar := bar_index
            smtNote := ourHH ? "we HH / pair LH" : "we LH / pair HH"
            if showSMT
                eventLabel(bar_index - smtLen, smtPH, "SMT ▼", smtBearColor, false)
        else
            // SMT is a state at the most recent turn, not a permanent flag: a
            // pivot pair that agrees clears it.
            smtDir := "None"
            smtNote := ""

if canDetect and smtAvailable and not na(smtPL)
    ourPLOld := ourPLNew
    cmpPLOld := cmpPLNew
    ourPLNew := smtPL
    cmpPLNew := smtLAdj[smtLen]
    if not na(ourPLOld) and not na(cmpPLOld) and not na(cmpPLNew)
        ourLL = ourPLNew < ourPLOld
        cmpLL = cmpPLNew < cmpPLOld
        if ourLL != cmpLL
            smtDir := "Bullish"
            smtBar := bar_index
            smtNote := ourLL ? "we LL / pair HL" : "we HL / pair LL"
            if showSMT
                eventLabel(bar_index - smtLen, smtPL, "SMT ▲", smtBullColor, true)
        else
            smtDir := "None"
            smtNote := ""

// ── Draw on Liquidity ────────────────────────────────────────────────────────
// The ranking pass. Candidates are the whole unswept registry — every swing and
// internal pivot, with equal-highs and equal-lows clusters weighted up by the
// strength the registry already counted — plus the fixed reference levels the
// entire market watches.
if canDetect and showDOL
    dolAboveScore := 0.0
    dolAbovePx := na
    dolAboveName := ""
    dolBelowScore := 0.0
    dolBelowPx := na
    dolBelowName := ""

    for lv in liqLevels
        // The side test comes first. A level price has already traded through is
        // spent whichever way it faces, and testing that before scoring halves
        // the magnetism calls — and the exponential inside them — every bar.
        if not lv.swept and not lv.broken and (lv.isHigh ? lv.price > close : lv.price < close)
            isEQ = lv.strength >= eqMinStrength
            lvW = isEQ ? 20.0 : lv.major ? 12.0 : 6.0
            lvSc = poolMagnetism(lv.price, lv.isHigh, lvW, bar_index - nz(lv.firstBar, lv.barIdx), lv.strength)
            if lvSc > (lv.isHigh ? dolAboveScore : dolBelowScore)
                lvNm = isEQ ? (lv.isHigh ? "EQH" : "EQL") : lv.major ? (lv.isHigh ? "Swing High" : "Swing Low") : (lv.isHigh ? "Int High" : "Int Low")
                if lv.isHigh
                    dolAboveScore := lvSc
                    dolAbovePx := lv.price
                    dolAboveName := lvNm
                else
                    dolBelowScore := lvSc
                    dolBelowPx := lv.price
                    dolBelowName := lvNm

    // Fixed reference levels. Weighted by how much of the market is watching
    // them: a previous month extreme is a far larger pool than yesterday's high.
    array.clear(refPx)
    array.clear(refNm)
    array.clear(refW)
    array.clear(refAge)
    array.clear(refHigh)
    if showPMHL
        pushRef(pmhRaw, "PMH", 30.0, barsSinceMonth, true)
        pushRef(pmlRaw, "PML", 30.0, barsSinceMonth, false)
    if showPWHL
        pushRef(pwhRaw, "PWH", 24.0, barsSinceWeek, true)
        pushRef(pwlRaw, "PWL", 24.0, barsSinceWeek, false)
    if showPDHL
        pushRef(pdhRaw, "PDH", 18.0, barsSinceDay, true)
        pushRef(pdlRaw, "PDL", 18.0, barsSinceDay, false)
    pushRef(asiaHigh, "Asian High", 14.0, na(asiaEndBar) ? 0 : bar_index - asiaEndBar, true)
    pushRef(asiaLow, "Asian Low", 14.0, na(asiaEndBar) ? 0 : bar_index - asiaEndBar, false)

    nRef = array.size(refPx)
    if nRef > 0
        for i = 0 to nRef - 1
            rPx = array.get(refPx, i)
            rHi = array.get(refHigh, i)
            // Reference levels are pools by construction, so they enter the
            // cluster term at strength 2 rather than as a single order.
            rSc = poolMagnetism(rPx, rHi, array.get(refW, i), array.get(refAge, i), 2)
            if rSc > 0
                if rHi and rSc > dolAboveScore
                    dolAboveScore := rSc
                    dolAbovePx := rPx
                    dolAboveName := array.get(refNm, i)
                else if not rHi and rSc > dolBelowScore
                    dolBelowScore := rSc
                    dolBelowPx := rPx
                    dolBelowName := array.get(refNm, i)

    if dolAboveScore > 0 and dolAboveScore >= dolBelowScore
        dolPx := dolAbovePx
        dolDir := 1
        dolName := dolAboveName
        dolScore := dolAboveScore
    else if dolBelowScore > 0
        dolPx := dolBelowPx
        dolDir := -1
        dolName := dolBelowName
        dolScore := dolBelowScore
    else
        dolPx := na
        dolDir := 0
        dolName := "None"
        dolScore := 0.0

// ===== MAIN CODE EXECUTION =====

// 1. Killzone / macro / Silver Bullet background shading
sessionBG = (showSessions and showSessionBG) ? getSessionBGColor() : na
bgcolor(sessionBG)

// 3. Detect FVGs on the Current Timeframe.
var FVG[] currentBullish = array.new<FVG>()
var FVG[] currentBearish = array.new<FVG>()
detectFVGs(high, low, close, open, timeframe.period, bar_index, minGapATR * volUnit, time[2], time, currentBullish, currentBearish)

// 4. Add newly detected Current TF FVGs to the main arrays
if canDetect
    for fvg in currentBullish
        array.push(bullishFVGs, fvg)
    for fvg in currentBearish
        array.push(bearishFVGs, fvg)

// 5. Detect FVGs on the Higher Timeframe (if enabled).
var FVG[] htfBullish_T = array.new<FVG>()
var FVG[] htfBearish_T = array.new<FVG>()
array.clear(htfBullish_T)
array.clear(htfBearish_T)
// The request is hoisted to the global scope and reuses the already-hoisted
// atrRef expression, which Pine re-evaluates in the higher timeframe's context.
[htf_h, htf_l, htf_c, htf_o, htf_barIdx, htf_atr, htf_t0, htf_t2] = request.security(syminfo.tickerid, higherTF, [high, low, close, open, bar_index, atrRef, time, time[2]], lookahead=barmerge.lookahead_off)
if mtfAnalysis and (barstate.isfirst or nz(htf_barIdx[1]) != nz(htf_barIdx))
    detectFVGs(htf_h, htf_l, htf_c, htf_o, higherTF, bar_index, minGapATR * math.max(nz(htf_atr), syminfo.mintick * 10), htf_t2, htf_t0, htfBullish_T, htfBearish_T)

// 6. Add newly detected HTF FVGs to the main arrays
if canDetect
    for fvg in htfBullish_T
        array.push(bullishFVGs, fvg)
    for fvg in htfBearish_T
        array.push(bearishFVGs, fvg)

// 7. The inversion check lives inside this pass because a gap has to be examined
// against the current close before it is aged out or hidden.
processAndCleanFVGs(bullishFVGs, low, high)
processAndCleanFVGs(bearishFVGs, low, high)

// 7a. Cache whether a live higher-timeframe gap exists on each side.
if canDetect
    itfGapBull := false
    itfGapBear := false
    if mtfAnalysis
        for f in bullishFVGs
            if not f.mitigated and f.timeframe != timeframe.period
                itfGapBull := true
                break
        for f in bearishFVGs
            if not f.mitigated and f.timeframe != timeframe.period
                itfGapBear := true
                break

// 7b. Composite PD arrays — BPR and Unicorn.
if canDetect
    if showBPR or showUnicorn
        for f in currentBullish
            if showBPR
                pairBPR(f, 1, bearishFVGs)
            if showUnicorn
                pairUnicornForFVG(f, 1)
        for f in currentBearish
            if showBPR
                pairBPR(f, -1, bullishFVGs)
            if showUnicorn
                pairUnicornForFVG(f, -1)
        for f in htfBullish_T
            if showBPR
                pairBPR(f, 1, bearishFVGs)
            if showUnicorn
                pairUnicornForFVG(f, 1)
        for f in htfBearish_T
            if showBPR
                pairBPR(f, -1, bullishFVGs)
            if showUnicorn
                pairUnicornForFVG(f, -1)
    if showUnicorn and array.get(flipFlag, 0) == bar_index
        pairUnicornForBreaker(bullishFVGs, 1)
        pairUnicornForBreaker(bearishFVGs, -1)

// 7c. Did a Unicorn form on this bar?
unicornFormed = false
unicornFormedDir = 0
if canDetect and showUnicorn
    for z in zones
        if z.active and z.kind == "Unicorn" and z.confirmBar == bar_index
            unicornFormed := true
            unicornFormedDir := z.dir
            break

// 7d. THE ENTRY STATE MACHINE, THEN THE SNIPER ENGINE.
// Order matters here. Arming records levels price reached on this bar; the
// update pass then ages every armed setup, retires the ones whose array failed
// or whose window ran out, and promotes any that confirmed. Only after that does
// the engine ask whether a confirmed setup is worth taking — which is correct,
// because the gates describe the market at the moment of entry, and the moment
// of entry is the confirmation, not the tap that preceded it.
if canDetect
    scanForArms(1)
    scanForArms(-1)
    updateArmed(bullCISD, bearCISD, intBullBreak or bullBreakSwing, intBearBreak or bearBreakSwing, displacementUp, displacementDn)

sniperFired = false
if canDetect and enableSniper
    watchModelL := ""
    watchModelS := ""
    watchScoreL := 0.0
    watchScoreS := 0.0
    [okL, scL, bcL] = sniperEvaluate(1, gateL)
    [okS, scS, bcS] = sniperEvaluate(-1, gateS)
    // ── Gate diagnostics ───────────────────────────────────────────────────
    // Every armed gate that failed is counted, not merely the first. Reporting
    // only the first failure is what hid the real blocker: a gate downstream of
    // a permanently-failing one never gets to report itself, so a deadlocked
    // pair looks like a single stubborn gate. The entry is the exception — it is
    // only meaningful once the cascade above it has passed, so counting it on
    // bars where nothing was even armed would swamp the row with noise.
    if showDiagnostics
        cascL = true
        cascS = true
        for gi = 0 to 7
            if not array.get(gateL, gi)
                array.set(gateBlockL, gi, array.get(gateBlockL, gi) + 1)
                cascL := false
            if not array.get(gateS, gi)
                array.set(gateBlockS, gi, array.get(gateBlockS, gi) + 1)
                cascS := false
        if cascL and not array.get(gateL, 8)
            array.set(gateBlockL, 8, array.get(gateBlockL, 8) + 1)
        if cascS and not array.get(gateS, 8)
            array.set(gateBlockS, 8, array.get(gateBlockS, 8) + 1)
    // Both directions confirming at once should not happen — an armed long and
    // an armed short need opposite confirmations on one candle — but if it does,
    // the higher stack score wins rather than the engine firing two opposing
    // trades on the same bar.
    if okL or okS
        cascadePassBars += 1
        // Only a direction that actually passed may raise the observed ceiling.
        // A B-grade score is a real number on the same scale but it never
        // cleared the cascade, so letting it set the bar the A+ threshold is
        // tuned against would quietly inflate it.
        bestScoreSeen := math.max(bestScoreSeen, math.max(okL ? scL : 0.0, okS ? scS : 0.0))
    // A+ always wins. B grade is only considered on bars where neither direction
    // produced a full cascade pass, so the two can never compete for one candle.
    aPlus = okL or okS
    bOnly = not aPlus and enableBTier and (bcL or bcS)
    takeLong = aPlus ? (okL and (not okS or scL >= scS)) : (bcL and (not bcS or scL >= scS))
    sDir = takeLong ? 1 : -1
    sOK = aPlus or bOnly
    sScore = takeLong ? scL : scS
    if sOK
        ArmedSetup setup = na
        if takeLong
            setup := array.get(confirmedLong, 0)
        else
            setup := array.get(confirmedShort, 0)
        [sModel, sNarr] = sniperModelName(sDir, setup.kind, setup.fresh)
        sEntry = close
        sSL = sniperStop(sDir, setup.armExtreme, setup.bottom, setup.top, sModel)
        sRisk = math.abs(sEntry - sSL)
        // A stop tighter than a tenth of the volatility unit is not a stop, it
        // is a rounding error, and the R multiples built on it would be fiction.
        stopUsable = sRisk >= 0.10 * volUnit
        if not stopUsable
            rejStop += 1
        if stopUsable
            // ── Objectives ──
            // TP1 and TP2 are the current leg's own standard-deviation
            // projections whenever that leg runs the trade's way, and R
            // multiples when it does not.
            sdUsable = oteValid and oteDir == sDir
            float sT1 = sDir == 1 ? sEntry + sRisk : sEntry - sRisk
            if sdUsable and not na(sd05) and (sDir == 1 ? sd05 > sT1 : sd05 < sT1)
                sT1 := sd05
            float sT2 = sDir == 1 ? sEntry + sRisk * 2.0 : sEntry - sRisk * 2.0
            if sdUsable and not na(sd10) and (sDir == 1 ? sd10 > sT2 : sd10 < sT2)
                sT2 := sd10
            // ── The final objective, and the reward:risk measured to it ──
            // Always the best pool lying in the trade's *own* direction, whether
            // or not it won the draw-on-liquidity ranking.
            //
            // The previous version substituted the draw only when it already
            // pointed the trade's way, and otherwise left the target at a
            // synthetic 3R. That inverted the whole test: a trade aligned with
            // the draw got a real, measurable objective and could be refused for
            // falling short of it, while a trade fighting the draw kept a
            // fictional 3R it had done nothing to earn and passed every time. The
            // gate was rejecting the best setups and waving through the worst.
            //
            // A short in a market being delivered upward now measures to the
            // nearest pool below — which is genuinely all it can expect — earns a
            // low R, and is correctly downgraded or refused.
            alignedPool = sDir == 1 ? dolAbovePx : dolBelowPx
            float sT3 = na
            if not na(alignedPool) and (sDir == 1 ? alignedPool > sEntry : alignedPool < sEntry)
                sT3 := alignedPool
            else if sdUsable and not na(sd20) and (sDir == 1 ? sd20 > sEntry : sd20 < sEntry)
                sT3 := sd20
            if na(sT3)
                sT3 := sDir == 1 ? sEntry + sRisk * 3.0 : sEntry - sRisk * 3.0
            // The final objective is a real level, and it can sit nearer than the
            // leg's own projections do. When it does, the earlier targets belong
            // inside it rather than beyond it — a TP2 past the level the trade is
            // being taken to is not a partial, it is a target that will never be
            // reached.
            if sDir == 1
                sT2 := math.min(sT2, sT3)
                sT1 := math.min(sT1, sT2)
            else
                sT2 := math.max(sT2, sT3)
                sT1 := math.max(sT1, sT2)
            sRR = math.abs(sT3 - sEntry) / sRisk
            lastFire = takeLong ? lastSniperBarL : lastSniperBarS
            cooled = na(lastFire) or bar_index - lastFire >= sniperCooldown

            if aPlus and sScore >= aPlusThreshold and sRR >= minSignalRR and cooled
                if takeLong
                    lastSniperBarL := bar_index
                else
                    lastSniperBarS := bar_index
                lastSniperBar := bar_index
                sniperDir := sDir
                sniperModel := sModel
                sniperNarrative := sNarr
                sniperScore := sScore
                sniperEntry := sEntry
                sniperSL := sSL
                sniperTP1 := sT1
                sniperTP2 := sT2
                sniperTP3 := sT3
                sniperRR := sRR
                sniperFired := true
                signalCount += 1
                sCol = sDir == 1 ? sniperBullColor : sniperBearColor
                // A flag, not an essay. The reasoning lives in the tooltip, one
                // hover away, so clustered signals stay readable.
                sTip = sModel + "\n" + sNarr + "\nscore " + str.tostring(sScore, "#") + "  ·  " + str.tostring(sRR, "#.#") + "R  ·  SL " + str.tostring(sSL, format.mintick) + "\narmed " + str.tostring(bar_index - setup.armBar) + "b ago"
                sTxt = (sDir == 1 ? "▲ BUY " : "▼ SELL ") + str.tostring(sScore, "#") + "\n" + sModel
                array.push(sniperLabelRefs, label.new(bar_index, sDir == 1 ? low - tapTol * 4 : high + tapTol * 4, sTxt, style=sDir == 1 ? label.style_label_up : label.style_label_down, color=color.new(sCol, 10), textcolor=color.white, size=size.normal, tooltip=sTip))
                capLabels(sniperLabelRefs, 60)
                if riskManagement
                    array.push(riskLevels, createSniperRisk(bar_index, sEntry, sSL, sT1, sT2, sT3, sDir == 1))
                    capRiskLevels()
            else if bOnly
                // ── B grade ──
                // Confirmed at a live array with structure behind it, missed
                // exactly one armed gate. Scored on the identical stack, drawn
                // small and dim, and never given a triangle: the marker's job is
                // to be legible without ever being mistaken for an A+ entry.
                lastB = takeLong ? lastBTierBarL : lastBTierBarS
                bCooled = (na(lastB) or bar_index - lastB >= sniperCooldown) and cooled
                if sScore >= bTierThreshold and sRR >= bTierMinRR and bCooled
                    if takeLong
                        lastBTierBarL := bar_index
                    else
                        lastBTierBarS := bar_index
                    bTierCount += 1
                    missed = takeLong ? firstBlockedGate(gateL) : firstBlockedGate(gateS)
                    bCol = sDir == 1 ? sniperBullColor : sniperBearColor
                    bTip = "B grade · " + sModel + "\nmissing gate: " + missed + "\n" + sNarr + "\nscore " + str.tostring(sScore, "#") + "  ·  " + str.tostring(sRR, "#.#") + "R  ·  SL " + str.tostring(sSL, format.mintick)
                    bTxt = "B " + str.tostring(sScore, "#") + " " + (sDir == 1 ? "▲" : "▼") + "\n" + missed
                    array.push(bTierLabelRefs, label.new(bar_index, sDir == 1 ? low - tapTol * 2 : high + tapTol * 2, bTxt, style=sDir == 1 ? label.style_label_up : label.style_label_down, color=color.new(bCol, 55), textcolor=color.white, size=size.small, tooltip=bTip))
                    capLabels(bTierLabelRefs, 25)
            else
                // Every gate passed, the entry confirmed, and the setup still did
                // not fire. Recording why is the point: this is what turns a quiet
                // chart from "nothing is happening" into "here is what it is
                // waiting for".
                if sScore < aPlusThreshold
                    rejScore += 1
                else if sRR < minSignalRR
                    rejRR += 1
                else if not cooled
                    rejCooldown += 1
                if takeLong
                    watchModelL := sModel
                    watchScoreL := sScore
                else
                    watchModelS := sModel
                    watchScoreS := sScore
                if showWatchMarker
                    wTxt = "watch " + str.tostring(sScore, "#") + (sRR < minSignalRR ? " · " + str.tostring(sRR, "#.#") + "R" : "")
                    array.push(watchLabelRefs, label.new(bar_index, sDir == 1 ? low - tapTol : high + tapTol, wTxt, style=sDir == 1 ? label.style_label_up : label.style_label_down, color=color.new(watchMarkColor, 45), textcolor=color.white, size=size.tiny))
                    capLabels(watchLabelRefs, 15)

// 8. Draw everything on the last bar only.
if uiRedraw
    drawFVGs()
    drawZones()
    drawPurges()
    drawCISD()
    drawQM()
    drawOTE()
    // The liquidity map, the reference levels every desk watches, the
    // Asian range, the True Day Open and the draw price is being delivered to.
    drawLiqPools()
    drawHTFLevels()
    drawAsiaRange()
    drawTimeAndDOL()

// Signal markers. Every box on this chart carries a ▲/▼ telling you which way
// the *array* faces, which makes a signal drawn as one more label impossible to
// pick out. These are plotted on the price scale instead, so an entry is a
// marker under or over the candle and nothing else on the chart looks like it.
plotshape(sniperFired and sniperDir == 1, title="Sniper BUY", style=shape.triangleup, location=location.belowbar, color=sniperBullColor, size=size.normal)
plotshape(sniperFired and sniperDir == -1, title="Sniper SELL", style=shape.triangledown, location=location.abovebar, color=sniperBearColor, size=size.normal)

// 9. Extend or retire the drawn SL/TP level sets
if array.size(riskLevels) > 0
    updateRiskManagementLines()

// 10. Update the dashboard
updateStatusTable()

// 11. Process alerts
if enableAlerts
    // CISD is the scout, structure is the confirmation; both are reported so the
    // sequence is visible on the alert feed.
    if bullCISD
        alert("CISD ▲ Bullish | level " + str.tostring(lastCISDLevel, format.mintick) + (cisdDisplaced ? " | displaced" : "") + (cisdPurgeUp ? " | post-purge" : "") + " | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar)

    if bearCISD
        alert("CISD ▼ Bearish | level " + str.tostring(lastCISDLevel, format.mintick) + (cisdDisplaced ? " | displaced" : "") + (cisdPurgeDn ? " | post-purge" : "") + " | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar)

    if purgeUpNow
        alert("Sellside liquidity purged | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar)

    if purgeDnNow
        alert("Buyside liquidity purged | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar)

    if not na(lastQMBar) and lastQMBar == bar_index
        alert("Quasimodo " + lastQMDir + " | QML entry | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar)

    // A Unicorn is the highest-tier array the engine can produce, so it
    // is worth an alert on formation rather than waiting for an entry trigger.
    if unicornFormed
        alert("Unicorn " + (unicornFormedDir == 1 ? "▲ Bullish" : "▼ Bearish") + " | Breaker + FVG | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar)

    // Each one carries the level it is measured from — the raided extreme for
    // Turtle Soup, the swept Asian edge for Judas — so the alert is actionable
    // on its own.
    if not na(lastTSBar) and lastTSBar == bar_index
        alert("Turtle Soup " + lastTSDir + " | raid " + str.tostring(lastTSStop, format.mintick) + " | " + getActiveWindow() + " | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar)

    if not na(judasBar) and judasBar == bar_index
        alert("Judas Swing " + judasDir + " | Asian range swept @ " + str.tostring(judasLevel, format.mintick) + " | " + getActiveWindow() + " | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar)

    // Guarded on the direction as well as the bar: a pivot high and a pivot low
    // can confirm on the same candle, and the second one clearing the state
    // would otherwise fire an alert announcing "SMT None".
    if not na(smtBar) and smtBar == bar_index and smtDir != "None"
        alert("SMT " + smtDir + " vs " + smtSymUsed + " | " + smtNote + " | " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar)

    // ── The consolidated payload ──
    // One machine-readable message carrying everything a webhook or a bot needs
    // to place the trade: the named model, the direction, the invalidation-based
    // stop, all three objectives, the realised R and the narrative that explains
    // the entry. Written with single quotes so the JSON's own double quotes need
    // no escaping.
    if sniperFired
        alert('{"symbol":"' + syminfo.ticker + '","timeframe":"' + timeframe.period + '","model":"' + sniperModel + '","direction":"' + (sniperDir == 1 ? "long" : "short") + '","entry":' + str.tostring(sniperEntry, format.mintick) + ',"sl":' + str.tostring(sniperSL, format.mintick) + ',"tp1":' + str.tostring(sniperTP1, format.mintick) + ',"tp2":' + str.tostring(sniperTP2, format.mintick) + ',"tp3":' + str.tostring(sniperTP3, format.mintick) + ',"rr":' + str.tostring(sniperRR, "#.##") + ',"score":' + str.tostring(sniperScore, "#") + ',"session":"' + getActiveWindow() + '","dol":"' + dolName + '","narrative":"' + sniperNarrative + '"}', alert.freq_once_per_bar)


